// The renderer: Vulkan 1.4 (engine/vk.mettle), everything on the GPU, PHOTOREAL. The sun's shadow map in two cascades
// (2048 each: 7 m round the eye, 40 m beyond); the scene -- sky, blocks, skinned and static meshes, the ground last (its
// shader the dearest: what's hidden of it never shaded) -- into a G-buffer of what each surface is (albedo + occlusion,
// normal + roughness, object id / class / metalness / distance, the light it gives off); then its light (light_pass:
// ambient occlusion, a compute pass and its blur, shaders/ao.comp; the sun, the sky, shaders/shade.frag) into HDR, the
// effects drawn into that against the scene's depth, and the lens and the film (final_pass: the bloom chain, the
// exposure and Reinhard, FXAA -- all compute passes) into the picture; the HUD over it; the picture onto the swapchain.
// The frame: frame_begin / shadow_begin x2 / draw_* / main_begin / draw_* / draw_ground / light_pass / fx_begin / fx /
// final_pass / hud / frame_end / vk_present. frame_begin is 0 when there's no frame to draw (minimised): every call
// after it does nothing until the next.
// A GAME EXTENDS IT, never edits it: GLSL spliced into the engine's shaders (render_ext, before render_init: the
// RX_* slots, each a set of functions the shader calls -- shaders/ext/ holds the defaults; shaders/vk.glsl is what
// they see), and hooks called as it draws (HK: its own 256 bytes of data for a skinned / static mesh, for the light
// pass, for the film -- EX in GLSL; its own pass after the glow). Object classes: 3 a block, 8 the ground; the game
// numbers the rest. GPU zones: the engine's own (GZ_*), the game's defined with gz_define.
import "std/io";
import "std/mem";
import "vk";
import "vkc";
import "math";
import "assets";
import "shader_src";

// the extension slots: where a game's GLSL goes (each shader's "#pragma ext")
fn RX_SKIN_VS() -> int32 { return 0; }         // skin.vert: ext_vertex() (may #define MAX_BONES)
fn RX_STATIC_VS() -> int32 { return 1; }       // static.vert: ext_vertex()
fn RX_SURFACE_FS() -> int32 { return 2; }      // textured.frag: ext_clip(), ext_surface(...)
fn RX_SKIN_SH_VS() -> int32 { return 3; }      // skin_shadow.vert: ext_vertex()
fn RX_STATIC_SH_VS() -> int32 { return 4; }    // static_shadow.vert: ext_vertex()
fn RX_DEPTH_FS() -> int32 { return 5; }        // depth.frag: ext_fragment()
fn RX_LIGHT_FS() -> int32 { return 6; }        // shade.frag: ext_light_pre / _surface / _mirror / _ground_mask / _extra
fn RX_FINAL_FS() -> int32 { return 7; }        // final.comp: ext_final_offset, ext_final
var RX_SRC: cstring[8];
var RX_SET: int32[8];
fn render_ext(slot: int32, src: cstring) { RX_SRC[slot] = src; RX_SET[slot] = 1; }
fn rx(slot: int32, dflt: string) -> cstring {
  if (RX_SET[slot] != 0) { return RX_SRC[slot]; }
  return dflt.chars;
}

// the hooks: what the game does as the engine draws (each a no-op until it's set). Each data hook gets the draw's
// extension block -- 256 bytes the GPU reads as EX (ExtB: vec4 v[16]) -- to fill; textures go in it as T2[] indices
struct RenderHooks {
  skin: fn(uint8*) -> void;    // a skinned mesh's (R->shadow_pass: which pass)
  stat: fn(uint8*) -> void;    // a static mesh's
  light: fn(uint8*) -> void;   // the light pass's
  post: fn() -> void;          // after the glow, before the film: a pass of its own (tgt_make, draw_block, post_dispatch)
  film: fn(uint8*) -> void;    // the film's
}
var HK: RenderHooks* = 0;
fn hook_nop_b(p: uint8*) { }
fn hook_nop() { }
fn render_hooks() -> RenderHooks* {
  if (HK == 0) {
    HK = new RenderHooks;
    HK->skin = hook_nop_b; HK->stat = hook_nop_b; HK->light = hook_nop_b; HK->post = hook_nop; HK->film = hook_nop_b;
  }
  return HK;
}

fn SHADOW_N() -> int32 { return 2048; }             // a cascade of the sun's shadow map (texels a side)
fn CASC0() -> float64 { return 7.0; }             // the near cascade's half width (m)
fn CASC1() -> float64 { return 40.0; }            // the far one's
fn QUAD_CAP() -> int32 { return 8192; }           // HUD / FX quads a frame
fn QV_FLOATS() -> int32 { return 9; }             // a quad vertex: x y z, u v, r g b a
fn NBLOOM() -> int32 { return 6; }                // the glow's chain: half size down to a 64th

// the frame's data (FR in GLSL: shaders/vk.glsl's FrameB), byte offsets
fn FB_VP() -> int64 { return 0; }
fn FB_INV_VP() -> int64 { return 64; }
fn FB_PREV_VP() -> int64 { return 128; }
fn FB_LIGHT_VP() -> int64 { return 192; }        // (two: 192, 256)
fn FB_SUN_DIR() -> int64 { return 320; }
fn FB_SUN_COL() -> int64 { return 336; }
fn FB_SKY_COL() -> int64 { return 352; }
fn FB_GND_COL() -> int64 { return 368; }
fn FB_FOG() -> int64 { return 384; }
fn FB_CAM() -> int64 { return 400; }
fn FB_SCREEN() -> int64 { return 416; }
fn FB_MISC() -> int64 { return 432; }
fn FB_SIZE() -> int64 { return 448; }
// a draw's (DR: DrawB)
fn DB_MODEL() -> int64 { return 0; }
fn DB_VP() -> int64 { return 64; }
fn DB_TINT() -> int64 { return 128; }
fn DB_OBJ() -> int64 { return 144; }
fn DB_TEX() -> int64 { return 160; }
fn DB_TEX2() -> int64 { return 176; }
fn DB_P0() -> int64 { return 192; }
fn DB_P1() -> int64 { return 208; }
fn DB_BONES() -> int64 { return 224; }
fn DB_VERTS() -> int64 { return 232; }
fn DB_SIZE() -> int64 { return 256; }

fn blk_m4(b: uint8*, off: int64, m: float32*) { memcpy((rawptr)(b + off), (rawptr)m, 64); }
fn blk_v4(b: uint8*, off: int64, x: float64, y: float64, z: float64, w: float64) {
  var f: float32* = (float32*)(b + off);
  f[0] = (float32)x; f[1] = (float32)y; f[2] = (float32)z; f[3] = (float32)w;
}
fn blk_i4(b: uint8*, off: int64, x: int32, y: int32, z: int32, w: int32) {
  var v: int32* = (int32*)(b + off);
  v[0] = x; v[1] = y; v[2] = z; v[3] = w;
}
fn blk_addr(b: uint8*, off: int64, a: int64) { *(int64*)(b + off) = a; }

// pipeline kinds: what a pipeline draws into, and how
fn PK_GBUF() -> int32 { return 0; }               // the G-buffer: four colour targets and depth, tested and written
fn PK_GBUF_CULL() -> int32 { return 1; }          // ... back faces culled (the blocks)
fn PK_SKY() -> int32 { return 2; }                // ... depth tested, not written
fn PK_SHADOW() -> int32 { return 3; }             // the shadow map's depth, biased
fn PK_LIGHT() -> int32 { return 4; }              // the scene's light (one HDR target)
fn PK_FX() -> int32 { return 5; }                 // ... added into it, tested against the scene's depth
fn PK_HUD() -> int32 { return 6; }                // the picture, alpha over it

struct Renderer {
  // the pipelines: the scene's (into the G-buffer), the shadow map's, the light, the effects, the HUD
  pl_skin: int64; pl_skin_sh: int64; pl_tex: int64; pl_static_sh: int64; pl_box: int64;
  pl_ground: int64; pl_sky: int64; pl_hud: int64; pl_fx: int64; pl_shade: int64;
  // the compute passes: the occlusion and its blur, the glow's chain down and up, the lens and the film, FXAA
  pc_ao: int64; pc_aob: int64; pc_bdown: int64; pc_bup: int64; pc_final: int64; pc_fxaa: int64;
  t_ao: VkImg; t_ao2: VkImg;   // the occlusion (r), the distance (g)
  t_hdr: VkImg[2];             // the scene's light: this frame's, last frame's (the wet surfaces reflect it)
  hdr_i: int32;                // which is this frame's
  t_ldr: VkImg;                // the display colour, before FXAA
  t_out: VkImg;                // the picture: after FXAA, the HUD over it (onto the swapchain)
  t_bloom: VkImg[6];
  bloom: float64;              // how much of the glow
  exposure: float64;
  // the G-buffer: 0 albedo + occlusion (RGBA8), 1 normal + roughness (RGBA16F), 2 id / class / metalness / distance
  // (RGBA16F), 3 the light given off (RGBA8); its depth
  g: VkImg[4]; gdepth: VkImg; gw: int32; gh: int32;
  time: float64;               // seconds (the comic's embers, its grain)
  shadow: VkImg;               // the sun's: its two cascades side by side
  cube: VkBuf;                 // the blocks' unit cube (36 vertices as a static mesh's)
  white: uint32;               // a 1x1 white texture (the HUD's font when there's none)
  // the HUD's and the effects' quads: written straight into this frame's ring; what's been drawn of them
  hud: float32*; hud_n: int32; hud_base: int32; hud_addr: int64;
  fx: float32*; fx_n: int32; fx_base: int32; fx_addr: int64;
  fr: uint8*; fr_addr: int64;  // this frame's data (FR)
  d_addr: int64;               // the draw block made last (DR)
  x_ptr: uint8*; x_addr: int64;   // the extension block made last (EX)
  vp: float32[16];             // the camera's view-projection
  inv_vp: float32[16];
  light_vp: float32[32];       // the sun's two cascades
  casc: int32;                 // the one being drawn
  prev_vp: float32[16];        // last frame's view-projection
  cam: Vec3; cam_rot: Quat;
  w: int32; h: int32;
  p11: float64;                // the projection's y scale (pixels a metre at 1 m: h / 2 x p11)
  shadow_pass: int32;          // 1 while drawing into the shadow map
  in_pass: int32;              // drawing into targets (ended before a compute pass or the next targets)
  frame_ok: int32;             // there's a frame being recorded
  sun: Vec3;
  font: Font*;                 // the HUD's
  // GPU time: timestamps -- one as the frame's GPU work starts, then one as each stretch of it ends, with what that
  // stretch was (its zone, GZ_*); read back when the frame's slot comes round again (two frames on)
  tq_z: int32[128];            // (slot x 64 + timestamp)
  tq_n: int32[2];
  gz_raw: float64[24];         // each zone's time (ms) in the frame read back; eased (to be read)
  gz_ms: float64[24];
  gz_label: cstring[24];       // each zone's name, what it counts toward (gpu_ms); how many there are
  gz_cat: int32[24];
  gz_n: int32;
  gpu_ms: float64[5];          // shadow, scene, post, fx, hud
  gpu_total: float64;
  frame_n: int32;
}

var R: Renderer* = 0;

// ---------------------------------------------------------------- the frame's blocks of data
// a draw's block in this frame's ring, zeroed (DR: what the next push carries) -> where to write it
fn draw_block() -> uint8* {
  var p: uint8* = (uint8*)0;
  R->d_addr = vk_ring(DB_SIZE(), &p);
  memset((rawptr)p, 0, DB_SIZE());
  return p;
}
// an extension block (EX), for a hook to fill -> its address
fn ext_block() -> int64 {
  R->x_addr = vk_ring(256, &R->x_ptr);
  return R->x_addr;
}
fn push_draw(ext: int64) { vk_push(R->fr_addr, R->d_addr, ext); }

// ---------------------------------------------------------------- shaders and pipelines
var P_PRE: cstring = (cstring)0;
// a shader's source: the prelude, then the G-buffer's helpers (gbuf != 0), then its own (its extension spliced in)
fn src_of(body: string, ext: cstring, gbuf: int32) -> cstring {
  var b: cstring = glsl_splice(body.chars, ext);
  if (gbuf != 0) { return str_join3(P_PRE, SRC_common_glsl.chars, b); }
  return str_join(P_PRE, b);
}

fn pipe(kind: int32, vs: cstring, fs: cstring, what: cstring) -> int64 {
  var D: GfxDesc;
  D.vs = vk_glsl(SHK_VERTEX(), vs, what);
  D.fs = vk_glsl(SHK_FRAGMENT(), fs, what);
  D.dfmt = VK_FORMAT_UNDEFINED();
  D.dcmp = VK_COMPARE_OP_LESS_OR_EQUAL();
  D.cull = VK_CULL_MODE_NONE();
  if (kind == PK_GBUF() || kind == PK_GBUF_CULL() || kind == PK_SKY()) {
    D.ncol = 4;
    D.cfmt[0] = VK_FORMAT_R8G8B8A8_UNORM(); D.cfmt[1] = VK_FORMAT_R16G16B16A16_SFLOAT();
    D.cfmt[2] = VK_FORMAT_R16G16B16A16_SFLOAT(); D.cfmt[3] = VK_FORMAT_R8G8B8A8_UNORM();
    D.dfmt = VK_FORMAT_D32_SFLOAT();
    D.dtest = 1; D.dwrite = 1;
    if (kind == PK_SKY()) { D.dwrite = 0; }
    if (kind == PK_GBUF_CULL()) { D.cull = VK_CULL_MODE_BACK_BIT(); }
  }
  if (kind == PK_SHADOW()) { D.dfmt = VK_FORMAT_D32_SFLOAT(); D.dtest = 1; D.dwrite = 1; D.bias = 1; }
  if (kind == PK_LIGHT()) { D.ncol = 1; D.cfmt[0] = VK_FORMAT_R16G16B16A16_SFLOAT(); }
  if (kind == PK_FX()) {
    D.ncol = 1; D.cfmt[0] = VK_FORMAT_R16G16B16A16_SFLOAT();
    D.dfmt = VK_FORMAT_D32_SFLOAT(); D.dtest = 1; D.blend = 1;
  }
  if (kind == PK_HUD()) { D.ncol = 1; D.cfmt[0] = VK_FORMAT_R8G8B8A8_UNORM(); D.blend = 2; }
  var p: int64 = vk_pipeline_gfx(&D, what);
  if (D.vs != 0) { vkDestroyShaderModule(D.vs); }
  if (D.fs != 0) { vkDestroyShaderModule(D.fs); }
  return p;
}

fn comp(src: cstring, what: cstring) -> int64 {
  var m: int64 = vk_glsl(SHK_COMPUTE(), src, what);
  var p: int64 = vk_pipeline_compute(m, what);
  if (m != 0) { vkDestroyShaderModule(m); }
  return p;
}
// a game's own compute pass (its GLSL after the prelude: local_size 8 8, reading FR / DR / EX) -> its pipeline
fn render_compute(src: cstring, what: cstring) -> int64 { return comp(str_join(P_PRE, src), what); }

// a unit cube (-0.5..0.5), its faces' normals, uvs: 36 vertices as a static mesh's (8 floats each)
fn cube_make() {
  var v: float32* = (float32*)malloc(36 * 8 * 4);
  // each face: normal axis a, sign s; two triangles
  var n: int32 = 0;
  var face: int32 = 0;
  while (face < 6) {
    var ax: int32 = face / 2;
    var sg: float64 = 1.0;
    if (face % 2 == 1) { sg = -1.0; }
    var k: int32 = 0;
    while (k < 6) {
      // the quad's corners (u, v) in -0.5..0.5, wound counter-clockwise seen from outside
      // (two triangles: (-,-) (+,-) (+,+) and (-,-) (+,+) (-,+))
      var cu: float64 = -0.5; var cv: float64 = -0.5;
      if (k == 1) { cu = 0.5; cv = -0.5; }
      if (k == 2 || k == 4) { cu = 0.5; cv = 0.5; }
      if (k == 5) { cu = -0.5; cv = 0.5; }
      if (sg < 0.0) { var tmp: float64 = cu; cu = cv; cv = tmp; }
      var px: float64 = 0.0; var py: float64 = 0.0; var pz: float64 = 0.0;
      if (ax == 0) { px = 0.5 * sg; py = cu; pz = cv; }
      if (ax == 1) { py = 0.5 * sg; pz = cu; px = cv; }
      if (ax == 2) { pz = 0.5 * sg; px = cu; py = cv; }
      var o: int32 = n * 8;
      v[o] = (float32)px; v[o + 1] = (float32)py; v[o + 2] = (float32)pz;
      v[o + 3] = 0.0; v[o + 4] = 0.0; v[o + 5] = 0.0;
      if (ax == 0) { v[o + 3] = (float32)sg; }
      if (ax == 1) { v[o + 4] = (float32)sg; }
      if (ax == 2) { v[o + 5] = (float32)sg; }
      v[o + 6] = (float32)(cu + 0.5); v[o + 7] = (float32)(cv + 0.5);
      n = n + 1;
      k = k + 1;
    }
    face = face + 1;
  }
  vk_buf_upload(&R->cube, (uint8*)v, 36 * 32, VK_BUFFER_USAGE_STORAGE_BUFFER_BIT());
  free((uint8*)v);
}

fn render_init(font: Font*, w: int32, h: int32) -> int32 {
  R = new Renderer;
  R->font = font;
  render_hooks();
  gz_engine();
  R->w = w; R->h = h;
  P_PRE = SRC_vk_glsl.chars;
  var surf: cstring = rx(RX_SURFACE_FS(), SRC_ext_surface_glsl);
  var depth: cstring = rx(RX_DEPTH_FS(), SRC_ext_depth_glsl);
  var depth_fs: cstring = src_of(SRC_depth_frag, depth, 0);
  var no: cstring = "".chars;
  R->pl_skin = pipe(PK_GBUF(), src_of(SRC_skin_vert, rx(RX_SKIN_VS(), SRC_ext_vertex_glsl), 0), src_of(SRC_textured_frag, surf, 1), "skin".chars);
  R->pl_skin_sh = pipe(PK_SHADOW(), src_of(SRC_skin_shadow_vert, rx(RX_SKIN_SH_VS(), SRC_ext_vertex_glsl), 0), depth_fs, "skin shadow".chars);
  R->pl_tex = pipe(PK_GBUF(), src_of(SRC_static_vert, rx(RX_STATIC_VS(), SRC_ext_vertex_glsl), 0), src_of(SRC_textured_frag, surf, 1), "static".chars);
  R->pl_static_sh = pipe(PK_SHADOW(), src_of(SRC_static_shadow_vert, rx(RX_STATIC_SH_VS(), SRC_ext_vertex_glsl), 0), depth_fs, "static shadow".chars);
  R->pl_box = pipe(PK_GBUF_CULL(), src_of(SRC_static_vert, rx(RX_STATIC_VS(), SRC_ext_vertex_glsl), 0), src_of(SRC_box_frag, no, 1), "box".chars);
  R->pl_ground = pipe(PK_GBUF(), src_of(SRC_ground_vert, no, 0), src_of(SRC_ground_frag, no, 1), "ground".chars);
  R->pl_sky = pipe(PK_SKY(), src_of(SRC_sky_vert, no, 0), src_of(SRC_sky_frag, no, 1), "sky".chars);
  R->pl_hud = pipe(PK_HUD(), src_of(SRC_hud_vert, no, 0), src_of(SRC_hud_frag, no, 0), "hud".chars);
  R->pl_fx = pipe(PK_FX(), src_of(SRC_fx_vert, no, 0), src_of(SRC_fx_frag, no, 0), "fx".chars);
  R->pl_shade = pipe(PK_LIGHT(), src_of(SRC_sky_vert, no, 0), src_of(SRC_shade_frag, rx(RX_LIGHT_FS(), SRC_ext_light_glsl), 0), "shade".chars);
  R->pc_ao = comp(src_of(SRC_ao_comp, no, 0), "ao".chars);
  R->pc_aob = comp(src_of(SRC_ao_blur_comp, no, 0), "ao blur".chars);
  R->pc_bdown = comp(src_of(SRC_bloom_down_comp, no, 0), "bloom down".chars);
  R->pc_bup = comp(src_of(SRC_bloom_up_comp, no, 0), "bloom up".chars);
  R->pc_final = comp(src_of(SRC_final_comp, rx(RX_FINAL_FS(), SRC_ext_final_glsl), 0), "final".chars);
  R->pc_fxaa = comp(src_of(SRC_fxaa_comp, no, 0), "fxaa".chars);
  R->bloom = 0.045;
  R->exposure = 1.0;
  if (R->pl_skin == 0 || R->pl_skin_sh == 0 || R->pl_tex == 0 || R->pl_static_sh == 0 || R->pl_box == 0
      || R->pl_ground == 0 || R->pl_sky == 0 || R->pl_hud == 0 || R->pl_fx == 0 || R->pl_shade == 0
      || R->pc_ao == 0 || R->pc_aob == 0 || R->pc_bdown == 0 || R->pc_bup == 0 || R->pc_final == 0 || R->pc_fxaa == 0) {
    return 0;
  }
  // the shadow map: depth compared on lookup (TS[]), its two cascades side by side
  if (vk_target(&R->shadow, SHADOW_N() * 2, SHADOW_N(), VK_FORMAT_D32_SFLOAT(),
                VK_IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT() | VK_IMAGE_USAGE_SAMPLED_BIT(), SMP_SHADOW()) == 0) {
    return 0;
  }
  cube_make();
  var wpx: uint8* = (uint8*)malloc(4);
  wpx[0] = (uint8)255; wpx[1] = (uint8)255; wpx[2] = (uint8)255; wpx[3] = (uint8)255;
  R->white = vk_texture_rgba_s(wpx, 1, 1, SMP_LINEAR(), 1);
  free(wpx);
  R->sun = vunit(v3(-0.55, 0.42, -0.72));
  R->hud_n = QUAD_CAP() * 6;
  R->fx_n = QUAD_CAP() * 6;
  return 1;
}

// the GPU's zones: the stretches of the frame its time is put down to (in the order they come). The engine's own here;
// a game's in the numbers between (gz_define), each counted toward one of gpu_ms's five: 0 shadow, 1 scene, 2 post,
// 3 fx, 4 hud
fn GZ_SHADOW() -> int32 { return 0; }
fn GZ_SKY() -> int32 { return 1; }
fn GZ_AO() -> int32 { return 8; }
fn GZ_LIGHT() -> int32 { return 9; }
fn GZ_FX() -> int32 { return 10; }
fn GZ_BLOOM() -> int32 { return 12; }
fn GZ_FINAL() -> int32 { return 14; }
fn GZ_AA() -> int32 { return 15; }
fn GZ_HUD() -> int32 { return 16; }
fn GZ_MAX() -> int32 { return 24; }
fn GZ_N() -> int32 { return R->gz_n; }
fn gz_define(z: int32, name: cstring, cat: int32) {
  R->gz_label[z] = name;
  R->gz_cat[z] = cat;
  if (z + 1 > R->gz_n) { R->gz_n = z + 1; }
}
fn gz_engine() {
  var z: int32 = 0;
  while (z < GZ_MAX()) { R->gz_label[z] = "hud".chars; R->gz_cat[z] = 4; z = z + 1; }
  gz_define(GZ_SHADOW(), "shadow maps (2 cascades)".chars, 0);
  gz_define(GZ_SKY(), "sky + ground".chars, 1);
  gz_define(GZ_AO(), "ambient occlusion (compute)".chars, 2);
  gz_define(GZ_LIGHT(), "lighting (sun, sky)".chars, 2);
  gz_define(GZ_FX(), "world fx".chars, 3);
  gz_define(GZ_BLOOM(), "bloom (compute)".chars, 2);
  gz_define(GZ_FINAL(), "lens + film (compute)".chars, 2);
  gz_define(GZ_AA(), "anti-aliasing (FXAA, compute)".chars, 2);
  gz_define(GZ_HUD(), "hud".chars, 4);
}
fn gz_name(z: int32) -> cstring { return R->gz_label[z]; }
// the frame's GPU work starts (the shadow map); a stretch of it ends, zone z (gpu_zone: not while drawing the shadow
// map -- all of that is its own zone)
fn gpu_start() {
  var s: int32 = VK->fi;
  var i: int32 = vk_timestamp();
  if (i < 0) { return; }
  R->tq_z[s * 64 + i] = -1;
  R->tq_n[s] = i + 1;
}
fn gpu_end(z: int32) {
  if (R->frame_ok == 0) { return; }
  var s: int32 = VK->fi;
  if (R->tq_n[s] == 0) { return; }
  var i: int32 = vk_timestamp();
  if (i < 0) { return; }
  R->tq_z[s * 64 + i] = z;
  R->tq_n[s] = i + 1;
}
fn gpu_zone(z: int32) { if (R->shadow_pass == 0) { gpu_end(z); } }

fn pass_end() {
  if (R->in_pass != 0) { vk_render_end(); R->in_pass = 0; }
}

// the frame begins: the slot's last frame read back (each zone's time, the old five -- shadow, scene, post, fx, hud --
// the total), this frame's data and its HUD and effects quads made in its ring. 0: no frame (minimised) -- every call
// until the next frame_begin does nothing
fn frame_begin() -> int32 {
  R->frame_ok = 0;
  R->hud_n = QUAD_CAP() * 6;                     // (nothing taken while there's no frame)
  R->fx_n = QUAD_CAP() * 6;
  if (vk_frame_begin() == 0) { return 0; }
  R->frame_ok = 1;
  var s: int32 = VK->fi;
  var n: int32 = R->tq_n[s];
  if (n > 1 && VK->ts_n >= n) {
    var z: int32 = 0;
    while (z < GZ_N()) { R->gz_raw[z] = 0.0; z = z + 1; }
    var t0: int64 = VK->ts[0];
    var prev: int64 = t0;
    var i: int32 = 1;
    while (i < n) {
      var t: int64 = VK->ts[i];
      var zi: int32 = R->tq_z[s * 64 + i];
      if (zi >= 0) { R->gz_raw[zi] = R->gz_raw[zi] + (float64)(t - prev) / 1000000.0; }
      prev = t;
      i = i + 1;
    }
    R->gpu_total = (float64)(prev - t0) / 1000000.0;
    z = 0;
    while (z < GZ_N()) { R->gz_ms[z] = lerpf(R->gz_ms[z], R->gz_raw[z], 0.1); z = z + 1; }
    var g: int32 = 0;
    while (g < 5) { R->gpu_ms[g] = 0.0; g = g + 1; }
    z = 0;
    while (z < GZ_N()) { R->gpu_ms[R->gz_cat[z]] = R->gpu_ms[R->gz_cat[z]] + R->gz_raw[z]; z = z + 1; }
  }
  R->tq_n[s] = 0;
  R->fr_addr = vk_ring(FB_SIZE(), &R->fr);
  memset((rawptr)R->fr, 0, FB_SIZE());
  blk_m4(R->fr, FB_PREV_VP(), &R->prev_vp[0]);
  var p: uint8* = (uint8*)0;
  var qbytes: int64 = (int64)QUAD_CAP() * 6 * (int64)QV_FLOATS() * 4;
  R->hud_addr = vk_ring(qbytes, &p);
  R->hud = (float32*)p;
  R->fx_addr = vk_ring(qbytes, &p);
  R->fx = (float32*)p;
  R->hud_n = 0; R->hud_base = 0;
  R->fx_n = 0; R->fx_base = 0;
  return 1;
}
// the frame ends: the picture onto the swapchain (vk_present shows it)
fn frame_end() {
  if (R->frame_ok == 0) { return; }
  gpu_end(GZ_HUD());
  pass_end();
  out_ensure();
  frame_light();
  vk_frame_end(&R->t_out);
  R->frame_n = R->frame_n + 1;
  R->frame_ok = 0;
}

// the G-buffer at the window's size (made again when it changes)
fn gbuf_ensure(w: int32, h: int32) {
  var u: uint32 = VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT() | VK_IMAGE_USAGE_SAMPLED_BIT();
  vk_target(&R->g[0], w, h, VK_FORMAT_R8G8B8A8_UNORM(), u, SMP_NEAREST());
  vk_target(&R->g[1], w, h, VK_FORMAT_R16G16B16A16_SFLOAT(), u, SMP_NEAREST());
  vk_target(&R->g[2], w, h, VK_FORMAT_R16G16B16A16_SFLOAT(), u, SMP_NEAREST());
  vk_target(&R->g[3], w, h, VK_FORMAT_R8G8B8A8_UNORM(), u, SMP_NEAREST());
  vk_target(&R->gdepth, w, h, VK_FORMAT_D32_SFLOAT(), VK_IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT() | VK_IMAGE_USAGE_SAMPLED_BIT(), SMP_NEAREST());
  R->gw = w; R->gh = h;
}

// ---------------------------------------------------------------- the frame's passes
// a pass's target: w x h RGBA16F, read (T2[]: filtered or texel for texel) and written by compute passes (I16[])
fn tgt_make(T: VkImg*, w: int32, h: int32, linear: int32) {
  var smp: int32 = SMP_NEAREST();
  if (linear != 0) { smp = SMP_LINEAR(); }
  vk_target(T, w, h, VK_FORMAT_R16G16B16A16_SFLOAT(), VK_IMAGE_USAGE_SAMPLED_BIT() | VK_IMAGE_USAGE_STORAGE_BIT(), smp);
}

// a compute pass of a game's own (HK->post): its pipeline (render_compute) over w x h, the draw block made last (DR)
// and an extension block (0: none)
fn post_dispatch(pipe: int64, w: int32, h: int32, ext: int64) {
  pass_end();
  vk_bind_compute(pipe);
  push_draw(ext);
  vk_dispatch(w, h);
}

// the scene's light targets: two (this frame's, last frame's), each cleared when made
fn hdr_ensure(w: int32, h: int32) {
  var k: int32 = 0;
  while (k < 2) {
    var T: VkImg* = &R->t_hdr[k];
    if (T->img == 0 || T->w != w || T->h != h) {
      vk_target(T, w, h, VK_FORMAT_R16G16B16A16_SFLOAT(), VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT() | VK_IMAGE_USAGE_SAMPLED_BIT()
                | VK_IMAGE_USAGE_STORAGE_BIT() | VK_IMAGE_USAGE_TRANSFER_DST_BIT(), SMP_LINEAR());
      vk_clear(T);
    }
    k = k + 1;
  }
}

// the picture (after FXAA, under the HUD) at the frame's size
fn out_ensure() {
  var w: int32 = R->w;
  var h: int32 = R->h;
  if (w <= 0 || h <= 0) { w = VK->sc_w; h = VK->sc_h; }
  var made: int32 = 0;
  if (R->t_out.img == 0) { made = 1; }
  vk_target(&R->t_out, w, h, VK_FORMAT_R8G8B8A8_UNORM(), VK_IMAGE_USAGE_STORAGE_BIT() | VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT()
            | VK_IMAGE_USAGE_TRANSFER_SRC_BIT() | VK_IMAGE_USAGE_TRANSFER_DST_BIT() | VK_IMAGE_USAGE_SAMPLED_BIT(), SMP_LINEAR());
  if (made != 0) { vk_clear(&R->t_out); }
}

// THE LIGHT, after the G-buffer:
//   occlusion  how much of the sky each point's surroundings hide (shaders/ao.comp), smoothed across its surface
//              (ao_blur.comp, each way) -- compute passes
//   light      the sun through its cascades, the sky, the haze, what the game lays over it (shaders/shade.frag) -> HDR
fn light_pass() {
  if (R->frame_ok == 0) { return; }
  var w: int32 = R->w;
  var h: int32 = R->h;
  pass_end();
  hdr_ensure(w, h);
  tgt_make(&R->t_ao, w, h, 0);
  tgt_make(&R->t_ao2, w, h, 0);
  // ---- the occlusion, then smoothed both ways
  vk_read_cs(&R->gdepth); vk_read_cs(&R->g[1]); vk_read_cs(&R->g[2]);
  vk_write_cs(&R->t_ao);
  vk_bind_compute(R->pc_ao);
  var b: uint8* = draw_block();
  blk_i4(b, DB_TEX(), R->gdepth.tex, R->g[1].tex, R->g[2].tex, R->t_ao.stor);
  push_draw(0);
  vk_dispatch(w, h);
  vk_bind_compute(R->pc_aob);
  vk_read_cs(&R->t_ao); vk_write_cs(&R->t_ao2);
  b = draw_block();
  blk_i4(b, DB_TEX(), R->t_ao.tex, 0, 0, R->t_ao2.stor);
  blk_v4(b, DB_P0(), 1.0, 0.0, 0.0, 0.0);
  push_draw(0);
  vk_dispatch(w, h);
  vk_read_cs(&R->t_ao2); vk_write_cs(&R->t_ao);
  b = draw_block();
  blk_i4(b, DB_TEX(), R->t_ao2.tex, 0, 0, R->t_ao.stor);
  blk_v4(b, DB_P0(), 0.0, 1.0, 0.0, 0.0);
  push_draw(0);
  vk_dispatch(w, h);
  gpu_end(GZ_AO());
  // ---- the light
  var cur: int32 = R->hdr_i;
  var i: int32 = 0;
  while (i < 4) { vk_read_fs(&R->g[i]); i = i + 1; }
  vk_read_fs(&R->gdepth); vk_read_fs(&R->t_ao); vk_read_fs(&R->t_hdr[1 - cur]); vk_read_fs(&R->shadow);
  vk_render_begin(&R->t_hdr[cur], (VkImg*)0, (VkImg*)0, (VkImg*)0, (VkImg*)0, 0, 0);
  R->in_pass = 1;
  vk_bind_gfx(R->pl_shade);
  b = draw_block();
  blk_i4(b, DB_TEX(), R->g[0].tex, R->g[1].tex, R->g[2].tex, R->g[3].tex);
  blk_i4(b, DB_TEX2(), R->gdepth.tex, R->t_ao.tex, R->t_hdr[1 - cur].tex, R->shadow.tex);
  var x: int64 = ext_block();
  HK->light(R->x_ptr);
  push_draw(x);
  vk_draw(3);
  gpu_end(GZ_LIGHT());
}

// the effects (tracers, flashes, particles) drawn into the scene's light, tested against its depth
fn fx_begin() {
  if (R->frame_ok == 0) { return; }
  pass_end();
  vk_render_begin(&R->t_hdr[R->hdr_i], (VkImg*)0, (VkImg*)0, (VkImg*)0, &R->gdepth, 0, 1);
  R->in_pass = 1;
}

// THE LENS AND THE FILM, into the picture -- compute passes:
//   glow       the bloom chain: 13-tap down with a Karis average, tent up, added (Jimenez, CoD: AW) -- all of the
//              light, a little of it (a lens's glow, not a threshold's)
//   the game's own pass (HK->post)
//   film       the exposure, Reinhard, the lens's corners, a grain (shaders/final.comp; the game's extension, HK->film)
//   FXAA       its edges smoothed, into the picture
fn final_pass() {
  if (R->frame_ok == 0) { return; }
  var w: int32 = R->w;
  var h: int32 = R->h;
  var cur: int32 = R->hdr_i;
  pass_end();
  var bw: int32 = w;
  var bh: int32 = h;
  var i: int32 = 0;
  while (i < NBLOOM()) {
    bw = (bw + 1) / 2; bh = (bh + 1) / 2;
    if (bw < 1) { bw = 1; }
    if (bh < 1) { bh = 1; }
    tgt_make(&R->t_bloom[i], bw, bh, 1);
    i = i + 1;
  }
  // ---- the glow: down the chain, then up it, each level added onto the one above
  vk_bind_compute(R->pc_bdown);
  i = 0;
  while (i < NBLOOM()) {
    var src: VkImg* = &R->t_hdr[cur];
    if (i > 0) { src = &R->t_bloom[i - 1]; }
    var dst: VkImg* = &R->t_bloom[i];
    vk_read_cs(src); vk_write_cs(dst);
    var b: uint8* = draw_block();
    blk_i4(b, DB_TEX(), src->tex, 0, 0, dst->stor);
    var first: float64 = 0.0;
    if (i == 0) { first = 1.0; }
    blk_v4(b, DB_P0(), 1.0 / (float64)src->w, 1.0 / (float64)src->h, first, 0.0);      // (no threshold, no knee)
    blk_v4(b, DB_P1(), 0.0, 0.0, (float64)dst->w, (float64)dst->h);
    push_draw(0);
    vk_dispatch(dst->w, dst->h);
    i = i + 1;
  }
  vk_bind_compute(R->pc_bup);
  i = NBLOOM() - 1;
  while (i > 0) {
    var sm: VkImg* = &R->t_bloom[i];
    var up: VkImg* = &R->t_bloom[i - 1];
    vk_read_cs(sm); vk_write_cs(up);
    var b2: uint8* = draw_block();
    blk_i4(b2, DB_TEX(), sm->tex, 0, 0, up->stor);
    blk_v4(b2, DB_P0(), 1.0 / (float64)sm->w, 1.0 / (float64)sm->h, 1.0, 0.0);
    blk_v4(b2, DB_P1(), 0.0, 0.0, (float64)up->w, (float64)up->h);
    push_draw(0);
    vk_dispatch(up->w, up->h);
    i = i - 1;
  }
  gpu_end(GZ_BLOOM());
  // ---- the game's own pass, if it has one
  HK->post();
  // ---- the lens and the film
  tgt_ldr(w, h);
  vk_read_cs(&R->t_hdr[cur]); vk_read_cs(&R->t_bloom[0]); vk_write_cs(&R->t_ldr);
  vk_bind_compute(R->pc_final);
  var bf: uint8* = draw_block();
  blk_i4(bf, DB_TEX(), R->t_hdr[cur].tex, R->t_bloom[0].tex, 0, R->t_ldr.stor);
  var x: int64 = ext_block();
  HK->film(R->x_ptr);
  push_draw(x);
  vk_dispatch(w, h);
  gpu_end(GZ_FINAL());
  // ---- its edges smoothed, into the picture
  out_ensure();
  vk_read_cs(&R->t_ldr); vk_write_cs(&R->t_out);
  vk_bind_compute(R->pc_fxaa);
  var ba: uint8* = draw_block();
  blk_i4(ba, DB_TEX(), R->t_ldr.tex, 0, 0, R->t_out.stor);
  push_draw(0);
  vk_dispatch(w, h);
  gpu_end(GZ_AA());
  // (this frame's view kept: next frame's reflections find their points on its light)
  var q: int32 = 0;
  while (q < 16) { R->prev_vp[q] = R->vp[q]; q = q + 1; }
  R->hdr_i = 1 - cur;
}
fn tgt_ldr(w: int32, h: int32) {
  vk_target(&R->t_ldr, w, h, VK_FORMAT_R8G8B8A8_UNORM(), VK_IMAGE_USAGE_SAMPLED_BIT() | VK_IMAGE_USAGE_STORAGE_BIT(), SMP_LINEAR());
}

// the light the world shares, into the frame's data (read by every pass when the frame runs: what's here at
// frame_end is what it sees)
fn frame_light() {
  var f: uint8* = R->fr;
  var s: Vec3 = R->sun;
  blk_v4(f, FB_SUN_DIR(), s.x, s.y, s.z, 0.0);
  // (a clear afternoon: the sun's light about four times the sky's on open ground, the shade a cool blue; the air
  // clear near, hazed far)
  blk_v4(f, FB_SUN_COL(), 3.3, 2.85, 2.25, 0.0);
  blk_v4(f, FB_SKY_COL(), 0.30, 0.40, 0.60, 0.0);
  blk_v4(f, FB_GND_COL(), 0.20, 0.165, 0.125, 0.0);
  blk_v4(f, FB_FOG(), 0.72, 0.70, 0.66, 0.0011);
  blk_v4(f, FB_CAM(), R->cam.x, R->cam.y, R->cam.z, R->time);
  blk_v4(f, FB_SCREEN(), (float64)R->w, (float64)R->h, R->p11, R->exposure);
  blk_v4(f, FB_MISC(), CASC0() * 2.0 / (float64)SHADOW_N(), CASC1() * 2.0 / (float64)SHADOW_N(), R->bloom, 0.0);
}

// ---------------------------------------------------------------- the frame
// the shadow map's cascade k (0 near, 1 far): an orthographic box from the sun round a point ahead of the eye (along
// fwd, flattened), its half width CASC0 / CASC1, snapped to its texels so the shadows don't crawl as you move; into
// its half of the map (the first clears it all)
fn shadow_begin(eye: Vec3, fwd: Vec3, k: int32) {
  if (R->frame_ok == 0) { return; }
  var half: float64 = CASC0();
  var ahead: float64 = 4.0;
  if (k != 0) { half = CASC1(); ahead = 30.0; }
  var fl: Vec3 = v3(fwd.x, 0.0, fwd.z);
  if (vlen(fl) < 0.01) { fl = v3(0.0, 0.0, -1.0); }
  var focus: Vec3 = vadd(eye, vmul(vunit(fl), ahead));
  var sun_eye: Vec3 = vadd(focus, vmul(R->sun, 60.0));
  // the light's frame: looking down -sun
  var f: Vec3 = vneg(R->sun);
  var up: Vec3 = v3(0.0, 1.0, 0.0);
  var rt: Vec3 = vunit(vcross(f, up));
  var u: Vec3 = vcross(rt, f);
  var texel: float64 = half * 2.0 / (float64)SHADOW_N();
  var cx: float64 = m_floor(vdot(focus, rt) / texel) * texel;
  var cy: float64 = m_floor(vdot(focus, u) / texel) * texel;
  var view: float32* = (float32*)malloc(64);
  // rows: right, up, -forward
  view[0] = (float32)rt.x; view[4] = (float32)rt.y; view[8] = (float32)rt.z;
  view[1] = (float32)u.x; view[5] = (float32)u.y; view[9] = (float32)u.z;
  view[2] = (float32)-f.x; view[6] = (float32)-f.y; view[10] = (float32)-f.z;
  view[3] = 0.0; view[7] = 0.0; view[11] = 0.0;
  view[12] = (float32)(-cx); view[13] = (float32)(-cy); view[14] = (float32)vdot(f, sun_eye); view[15] = 1.0;
  var proj: float32* = (float32*)malloc(64);
  m4_ortho(proj, -half, half, -half, half, 1.0, 160.0);
  m4_mul(&R->light_vp[k * 16], proj, view);
  free((uint8*)view);
  free((uint8*)proj);
  blk_m4(R->fr, FB_LIGHT_VP() + (int64)k * 64, &R->light_vp[k * 16]);
  pass_end();
  if (k == 0) {
    gpu_start();
    vk_render_begin((VkImg*)0, (VkImg*)0, (VkImg*)0, (VkImg*)0, &R->shadow, 1, 0);
  } else {
    vk_render_begin((VkImg*)0, (VkImg*)0, (VkImg*)0, (VkImg*)0, &R->shadow, 0, 0);
  }
  R->in_pass = 1;
  vk_viewport(k * SHADOW_N(), 0, SHADOW_N(), SHADOW_N());
  vk_depth_bias(2.0, 1.5);
  R->shadow_pass = 1;
  R->casc = k;
}

// the camera: where it is, how it's turned (it looks down its -Z), its vertical FOV (degrees)
fn main_begin(cam: Vec3, rot: Quat, fov_deg: float64, w: int32, h: int32) {
  if (R->frame_ok == 0) { return; }
  gpu_end(GZ_SHADOW());
  pass_end();
  R->w = w; R->h = h;
  gbuf_ensure(w, h);
  R->shadow_pass = 0;
  R->cam = cam;
  R->cam_rot = rot;
  var view: float32* = (float32*)malloc(64);
  var proj: float32* = (float32*)malloc(64);
  m4_view(view, rot, cam);
  var aspect: float64 = (float64)w / maxf((float64)h, 1.0);
  m4_persp(proj, rad(fov_deg), aspect, 0.05, 900.0);
  R->p11 = (float64)proj[5];
  m4_mul(&R->vp[0], proj, view);
  // the inverse, for the sky's rays: (P V)^-1 = V^-1 P^-1 -- V^-1 is the camera's frame, P^-1 by hand
  var cf: float32* = (float32*)malloc(64);
  m4_from_qt(cf, rot, cam);
  var pinv: float32* = (float32*)malloc(64);
  var i: int32 = 0;
  while (i < 16) { pinv[i] = 0.0; i = i + 1; }
  pinv[0] = 1.0 / proj[0];
  pinv[5] = 1.0 / proj[5];
  pinv[11] = 1.0 / proj[14];
  pinv[14] = -1.0;
  pinv[15] = proj[10] / proj[14];
  m4_mul(&R->inv_vp[0], cf, pinv);
  free((uint8*)view); free((uint8*)proj); free((uint8*)cf); free((uint8*)pinv);
  blk_m4(R->fr, FB_VP(), &R->vp[0]);
  blk_m4(R->fr, FB_INV_VP(), &R->inv_vp[0]);
  frame_light();
  // the G-buffer cleared; the sky first, behind everything
  vk_render_begin(&R->g[0], &R->g[1], &R->g[2], &R->g[3], &R->gdepth, 1, 0);
  R->in_pass = 1;
  vk_bind_gfx(R->pl_sky);
  draw_block();
  push_draw(0);
  vk_draw(3);
  gpu_end(GZ_SKY());
}
// the ground: drawn after everything else in the scene (its shader the dearest: what's hidden of it is never shaded)
fn draw_ground() {
  if (R->frame_ok == 0) { return; }
  vk_bind_gfx(R->pl_ground);
  var b: uint8* = draw_block();
  blk_m4(b, DB_VP(), &R->vp[0]);
  blk_v4(b, DB_OBJ(), 1.0, 8.0, 0.0, 0.0);
  push_draw(0);
  vk_draw(6);
  gpu_end(GZ_SKY());
}

fn cur_vp() -> float32* {
  if (R->shadow_pass != 0) { return &R->light_vp[R->casc * 16]; }
  return &R->vp[0];
}

// a block: centre, half extents, its colour, its object id
fn draw_box(c: Vec3, half: Vec3, r: float64, g: float64, b: float64, obj: int32) {
  if (R->frame_ok == 0) { return; }
  var m: float32[16];
  m4_ident(&m[0]);
  m[0] = (float32)(half.x * 2.0); m[5] = (float32)(half.y * 2.0); m[10] = (float32)(half.z * 2.0);
  m[12] = (float32)c.x; m[13] = (float32)c.y; m[14] = (float32)c.z;
  if (R->shadow_pass != 0) { vk_bind_gfx(R->pl_static_sh); }
  else { vk_bind_gfx(R->pl_box); }
  var d: uint8* = draw_block();
  blk_m4(d, DB_MODEL(), &m[0]);
  blk_m4(d, DB_VP(), cur_vp());
  blk_v4(d, DB_TINT(), r, g, b, 0.0);
  blk_v4(d, DB_OBJ(), (float64)obj, 3.0, 0.0, 0.0);
  blk_addr(d, DB_VERTS(), R->cube.addr);
  push_draw(0);
  vk_draw(36);
}

// a skinned mesh: its palette (16 floats a joint, nb of them, the model's space), its frame (model -> world), the first
// of its material set's textures (tex_base: a mesh may carry several liveries), a glow (hit flash), a material to leave
// out (-1 none), its object id and class
fn draw_skinned(M: SkinMesh*, palette: float32*, nb: int32, model: float32*, tex_base: int32, glow: float64, skip: int32,
                obj: int32, cls: int32) {
  if (R->frame_ok == 0) { return; }
  var pp: uint8* = (uint8*)0;
  var bones: int64 = vk_ring((int64)nb * 64, &pp);
  memcpy((rawptr)pp, (rawptr)palette, (int64)nb * 64);
  var x: int64 = ext_block();
  HK->skin(R->x_ptr);
  if (R->shadow_pass != 0) { vk_bind_gfx(R->pl_skin_sh); }
  else { vk_bind_gfx(R->pl_skin); }
  // (the draw's block, then one a part: each part's textures its own)
  var base: uint8[256];
  memset((rawptr)&base[0], 0, 256);
  blk_m4(&base[0], DB_MODEL(), model);
  blk_m4(&base[0], DB_VP(), cur_vp());
  blk_v4(&base[0], DB_TINT(), 1.0, 1.0, 1.0, glow);
  blk_v4(&base[0], DB_OBJ(), (float64)obj, (float64)cls, 0.0, 0.0);
  blk_addr(&base[0], DB_BONES(), bones);
  blk_addr(&base[0], DB_VERTS(), M->vb.addr);
  var i: int32 = 0;
  while (i < M->nsub) {
    if (M->mat[i] == skip) { i = i + 1; continue; }
    var d: uint8* = draw_block();
    memcpy((rawptr)d, (rawptr)&base[0], 256);
    blk_i4(d, DB_TEX(), (int32)M->tex[M->mat[i] + tex_base], (int32)M->flat[M->mat[i] + tex_base], 0, 0);
    push_draw(x);
    vk_draw_indexed(&M->ib, M->first[i], M->count[i]);
    i = i + 1;
  }
}

// a static textured mesh at `model`, its object id and class
fn draw_static(G: StaticMesh*, model: float32*, obj: int32, cls: int32) {
  if (R->frame_ok == 0) { return; }
  if (G == 0) { return; }
  var x: int64 = 0;
  if (R->shadow_pass != 0) { vk_bind_gfx(R->pl_static_sh); }
  else {
    vk_bind_gfx(R->pl_tex);
    x = ext_block();
    HK->stat(R->x_ptr);
  }
  var d: uint8* = draw_block();
  blk_m4(d, DB_MODEL(), model);
  blk_m4(d, DB_VP(), cur_vp());
  blk_v4(d, DB_TINT(), 1.0, 1.0, 1.0, 0.0);
  blk_v4(d, DB_OBJ(), (float64)obj, (float64)cls, 0.0, 0.0);
  blk_i4(d, DB_TEX(), (int32)G->tex, (int32)G->flat, 0, 0);
  blk_addr(d, DB_VERTS(), G->vb.addr);
  push_draw(x);
  vk_draw_indexed(&G->ib, 0, G->count);
}

// ---------------------------------------------------------------- quads (HUD in pixels, FX in the world)
fn qv(buf: float32*, n: int32, x: float64, y: float64, z: float64, u: float64, v: float64, r: float64, g: float64, b: float64, a: float64) {
  var o: int32 = n * QV_FLOATS();
  buf[o] = (float32)x; buf[o + 1] = (float32)y; buf[o + 2] = (float32)z;
  buf[o + 3] = (float32)u; buf[o + 4] = (float32)v;
  buf[o + 5] = (float32)r; buf[o + 6] = (float32)g; buf[o + 7] = (float32)b; buf[o + 8] = (float32)a;
}

// a screen rectangle; u0 < 0: solid colour, else font atlas texture coordinates
fn hud_quad(x: float64, y: float64, w: float64, h: float64, u0: float64, v0: float64, u1: float64, v1: float64,
            r: float64, g: float64, b: float64, a: float64) {
  if (R->hud_n + 6 > QUAD_CAP() * 6) { return; }
  var n: int32 = R->hud_n;
  qv(R->hud, n, x, y, 0.0, u0, v0, r, g, b, a);
  qv(R->hud, n + 1, x + w, y, 0.0, u1, v0, r, g, b, a);
  qv(R->hud, n + 2, x + w, y + h, 0.0, u1, v1, r, g, b, a);
  qv(R->hud, n + 3, x, y, 0.0, u0, v0, r, g, b, a);
  qv(R->hud, n + 4, x + w, y + h, 0.0, u1, v1, r, g, b, a);
  qv(R->hud, n + 5, x, y + h, 0.0, u0, v1, r, g, b, a);
  R->hud_n = n + 6;
}
fn hud_rect(x: float64, y: float64, w: float64, h: float64, r: float64, g: float64, b: float64, a: float64) {
  hud_quad(x, y, w, h, -1.0, 0.0, -1.0, 0.0, r, g, b, a);
}
// a rotated bar (the hit marker's strokes): centre, half length, half width, angle
fn hud_bar(cx: float64, cy: float64, hl: float64, hw: float64, ang: float64, r: float64, g: float64, b: float64, a: float64) {
  if (R->hud_n + 6 > QUAD_CAP() * 6) { return; }
  var c: float64 = m_cos(ang);
  var s: float64 = m_sin(ang);
  var ax: float64 = c * hl; var ay: float64 = s * hl;
  var bx: float64 = -s * hw; var by: float64 = c * hw;
  var n: int32 = R->hud_n;
  qv(R->hud, n, cx - ax - bx, cy - ay - by, 0.0, -1.0, 0.0, r, g, b, a);
  qv(R->hud, n + 1, cx + ax - bx, cy + ay - by, 0.0, -1.0, 0.0, r, g, b, a);
  qv(R->hud, n + 2, cx + ax + bx, cy + ay + by, 0.0, -1.0, 0.0, r, g, b, a);
  qv(R->hud, n + 3, cx - ax - bx, cy - ay - by, 0.0, -1.0, 0.0, r, g, b, a);
  qv(R->hud, n + 4, cx + ax + bx, cy + ay + by, 0.0, -1.0, 0.0, r, g, b, a);
  qv(R->hud, n + 5, cx - ax + bx, cy - ay + by, 0.0, -1.0, 0.0, r, g, b, a);
  R->hud_n = n + 6;
}
// text at (x, y) (top left), `size` px tall; align 0 left, 1 centre, 2 right. -> its width
fn hud_text(s: cstring, x: float64, y: float64, size: float64, align: int32, r: float64, g: float64, b: float64, a: float64) -> float64 {
  var F: Font* = R->font;
  if (F == (Font*)0) { return 0.0; }
  var n: int32 = 0;
  while (s[n] != (uint8)0) { n = n + 1; }
  var sc: float64 = size / (float64)F->ch;
  var cw: float64 = (float64)F->cw * sc * 0.92;
  var w: float64 = cw * (float64)n;
  var x0: float64 = x;
  if (align == 1) { x0 = x - w * 0.5; }
  if (align == 2) { x0 = x - w; }
  var i: int32 = 0;
  while (i < n) {
    var c: int32 = (int32)s[i] - 32;
    if (c > 0 && c < 95) {
      var gx: float64 = (float64)((c % F->cols) * F->cw);
      var gy: float64 = (float64)((c / F->cols) * F->ch);
      var u0: float64 = gx / (float64)F->aw; var v0: float64 = gy / (float64)F->ah;
      var u1: float64 = (gx + (float64)F->cw) / (float64)F->aw; var v1: float64 = (gy + (float64)F->ch) / (float64)F->ah;
      // (a soft shadow under it, then the glyph)
      hud_quad(x0 + (float64)i * cw + 1.5, y + 1.5, (float64)F->cw * sc, size, u0, v0, u1, v1, 0.0, 0.0, 0.0, a * 0.55);
      hud_quad(x0 + (float64)i * cw, y, (float64)F->cw * sc, size, u0, v0, u1, v1, r, g, b, a);
    }
    i = i + 1;
  }
  return w;
}

// a world quad facing the camera: a streak from a to b, `wd` wide (tracers), colour additive
fn fx_streak(a: Vec3, b: Vec3, wd: float64, r: float64, g: float64, bl: float64, al: float64) {
  if (R->fx_n + 6 > QUAD_CAP() * 6) { return; }
  var d: Vec3 = vsub(b, a);
  var mid: Vec3 = vlerp(a, b, 0.5);
  var side: Vec3 = vunit(vcross(d, vsub(R->cam, mid)));
  side = vmul(side, wd * 0.5);
  var n: int32 = R->fx_n;
  var p0: Vec3 = vsub(a, side); var p1: Vec3 = vadd(a, side); var p2: Vec3 = vadd(b, side); var p3: Vec3 = vsub(b, side);
  // (u runs -1..1 along: the streak tapers at both ends)
  qv(R->fx, n, p0.x, p0.y, p0.z, -0.9, -1.0, r, g, bl, al);
  qv(R->fx, n + 1, p1.x, p1.y, p1.z, -0.9, 1.0, r, g, bl, al);
  qv(R->fx, n + 2, p2.x, p2.y, p2.z, 0.0, 1.0, r, g, bl, al);
  qv(R->fx, n + 3, p0.x, p0.y, p0.z, -0.9, -1.0, r, g, bl, al);
  qv(R->fx, n + 4, p2.x, p2.y, p2.z, 0.0, 1.0, r, g, bl, al);
  qv(R->fx, n + 5, p3.x, p3.y, p3.z, 0.0, -1.0, r, g, bl, al);
  R->fx_n = n + 6;
}
// a camera-facing blob at p, radius rr
fn fx_blob(p: Vec3, rr: float64, r: float64, g: float64, b: float64, a: float64) {
  if (R->fx_n + 6 > QUAD_CAP() * 6) { return; }
  var right: Vec3 = vmul(qrot(R->cam_rot, v3(1.0, 0.0, 0.0)), rr);
  var up: Vec3 = vmul(qrot(R->cam_rot, v3(0.0, 1.0, 0.0)), rr);
  var n: int32 = R->fx_n;
  var c0: Vec3 = vsub(vsub(p, right), up); var c1: Vec3 = vsub(vadd(p, right), up);
  var c2: Vec3 = vadd(vadd(p, right), up); var c3: Vec3 = vadd(vsub(p, right), up);
  qv(R->fx, n, c0.x, c0.y, c0.z, -1.0, -1.0, r, g, b, a);
  qv(R->fx, n + 1, c1.x, c1.y, c1.z, 1.0, -1.0, r, g, b, a);
  qv(R->fx, n + 2, c2.x, c2.y, c2.z, 1.0, 1.0, r, g, b, a);
  qv(R->fx, n + 3, c0.x, c0.y, c0.z, -1.0, -1.0, r, g, b, a);
  qv(R->fx, n + 4, c2.x, c2.y, c2.z, 1.0, 1.0, r, g, b, a);
  qv(R->fx, n + 5, c3.x, c3.y, c3.z, -1.0, 1.0, r, g, b, a);
  R->fx_n = n + 6;
}

// the effects queued since the last flush, added into the scene's light (inside fx_begin's pass). The quads stay where
// they were written (the GPU reads them as the frame runs): each flush draws its own stretch
fn fx_flush() {
  if (R->frame_ok == 0) { return; }
  var n: int32 = R->fx_n - R->fx_base;
  if (n > 0) {
    vk_bind_gfx(R->pl_fx);
    var b: uint8* = draw_block();
    blk_m4(b, DB_VP(), &R->vp[0]);
    blk_addr(b, DB_VERTS(), R->fx_addr);
    push_draw(0);
    vk_draw_from(R->fx_base, n);
  }
  R->fx_base = R->fx_n;
}

// the HUD queued since the last flush, over the picture
fn hud_flush() {
  if (R->frame_ok == 0) { return; }
  var n: int32 = R->hud_n - R->hud_base;
  if (n > 0) {
    pass_end();
    out_ensure();
    vk_render_begin(&R->t_out, (VkImg*)0, (VkImg*)0, (VkImg*)0, (VkImg*)0, 0, 0);
    R->in_pass = 1;
    vk_bind_gfx(R->pl_hud);
    var b: uint8* = draw_block();
    var ft: int32 = (int32)R->white;
    if (R->font != (Font*)0) { ft = (int32)R->font->tex; }
    blk_i4(b, DB_TEX(), ft, 0, 0, 0);
    blk_addr(b, DB_VERTS(), R->hud_addr);
    push_draw(0);
    vk_draw_from(R->hud_base, n);
  }
  R->hud_base = R->hud_n;
}

// the world point -> the screen (pixels); z < 0 when it's behind the camera
fn world_to_screen(p: Vec3) -> Vec3 {
  var m: float32* = &R->vp[0];
  var x: float64 = m[0] * p.x + m[4] * p.y + m[8] * p.z + m[12];
  var y: float64 = m[1] * p.x + m[5] * p.y + m[9] * p.z + m[13];
  var w: float64 = m[3] * p.x + m[7] * p.y + m[11] * p.z + m[15];
  if (w < 0.001) { return v3(0.0, 0.0, -1.0); }
  return v3((x / w * 0.5 + 0.5) * (float64)R->w, (0.5 - y / w * 0.5) * (float64)R->h, w);
}
