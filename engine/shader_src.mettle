// GLSL as Mettle strings -- generated by tools/embed_shaders.mettle from engine\shaders; don't edit by hand
var SRC_ao_comp: string = "// AMBIENT OCCLUSION (McGuire's Scalable Ambient Obscurance, in the world), a compute pass, a pixel an invocation: how\n// much of the sky a point's surroundings hide from it -- twelve samples on a spiral round it in screen space out to\n// half a metre, each counted by how far it rises over the surface's plane and how near it is. The plane is the depth's\n// own (each way, the nearer neighbour's difference: no edge's jump in it) -- the geometry's, not the normal maps' and\n// the bullet holes' bumps (those are the light's to shade, not the occlusion's). Out (I16[DR.tex.w]): r the occlusion\n// (1 open), g the distance (for the blur).\nlayout(local_size_x = 8, local_size_y = 8) in;\n#define uDepthT T2[DR.tex.x]\n#define uNrmT T2[DR.tex.y]\n#define uObjT T2[DR.tex.z]\nvec3 wpos(ivec2 q) {{\n  float z = texelFetch(uDepthT, q, 0).r;\n  vec2 ndc = (vec2(q) + 0.5) / uScreen * 2.0 - 1.0;\n  vec4 w = uInvVP * vec4(ndc, z * 2.0 - 1.0, 1.0);\n  return w.xyz / w.w;\n}\nvoid main() {{\n  ivec2 ip = ivec2(gl_GlobalInvocationID.xy);\n  if (ip.x >= int(uScreen.x) || ip.y >= int(uScreen.y)) return;\n  vec2 fc = vec2(ip) + 0.5;\n  float D = texelFetch(uObjT, ip, 0).w;\n  if (D > 900.0) {{ imageStore(I16[DR.tex.w], ip, vec4(1.0, D, 0.0, 1.0)); return; }\n  vec3 P = wpos(ip);\n  ivec2 mx = ivec2(uScreen) - 1;\n  vec3 l = wpos(clamp(ip - ivec2(1, 0), ivec2(0), mx)) - P, r = wpos(clamp(ip + ivec2(1, 0), ivec2(0), mx)) - P;\n  vec3 b = wpos(clamp(ip - ivec2(0, 1), ivec2(0), mx)) - P, t = wpos(clamp(ip + ivec2(0, 1), ivec2(0), mx)) - P;\n  vec3 dx = dot(l, l) < dot(r, r) ? -l : r;\n  vec3 dy = dot(b, b) < dot(t, t) ? -b : t;\n  vec3 N = cross(dx, dy);\n  vec3 Ng = texelFetch(uNrmT, ip, 0).xyz;\n  N = dot(N, N) > 1e-16 ? normalize(N) : normalize(Ng + 1e-6);\n  if (dot(N, Ng) < 0.0) N = -N;\n  const float RAD = 0.5;\n  float rpx = RAD * uP11 * uScreen.y * 0.5 / max(D, 0.05);\n  if (rpx < 1.0) {{ imageStore(I16[DR.tex.w], ip, vec4(1.0, D, 0.0, 1.0)); return; }\n  rpx = min(rpx, uScreen.y * 0.15);\n  float rot = fract(52.9829189 * fract(dot(fc, vec2(0.06711056, 0.00583715)))) * 6.2831853;\n  float sum = 0.0;\n  const int NS = 12;\n  for (int i = 0; i < NS; i++) {{\n    float u = (float(i) + 0.5) / float(NS);\n    float an = u * 6.2831853 * 3.0 + rot;\n    ivec2 q = clamp(ip + ivec2(vec2(cos(an), sin(an)) * rpx * u), ivec2(0), ivec2(uScreen) - 1);\n    vec3 v = wpos(q) - P;\n    float vv = dot(v, v);\n    float vn = dot(v, N);\n    float f = max(RAD * RAD - vv, 0.0);\n    sum += f * f * f * max((vn - 0.012) / (vv + 0.004), 0.0);\n  }\n  float ao = max(0.0, 1.0 - sum * 5.0 / (pow(RAD, 6.0) * float(NS)));\n  imageStore(I16[DR.tex.w], ip, vec4(ao, D, 0.0, 1.0));\n}\n";
var SRC_ao_blur_comp: string = "// the occlusion smoothed one way (uDir), across the same surface only: each tap weighted by a Gaussian and by how near\n// its distance is to this pixel's (an edge between near and far isn't blurred over). Out: I16[DR.tex.w]\nlayout(local_size_x = 8, local_size_y = 8) in;\n#define uSrc T2[DR.tex.x]      // r the occlusion, g the distance\n#define uDir DR.p0.xy\nvoid main() {{\n  ivec2 ip = ivec2(gl_GlobalInvocationID.xy);\n  if (ip.x >= int(uScreen.x) || ip.y >= int(uScreen.y)) return;\n  vec4 c0 = texelFetch(uSrc, ip, 0);\n  float D = c0.g;\n  float s = c0.r, w = 1.0;\n  for (int k = -4; k <= 4; k++) {{\n    if (k == 0) continue;\n    ivec2 q = clamp(ip + ivec2(uDir * float(k) * 1.5), ivec2(0), ivec2(uScreen) - 1);\n    vec4 cq = texelFetch(uSrc, q, 0);\n    float g = exp(-float(k * k) / 9.0);\n    float wd = max(0.0, 1.0 - abs(cq.g - D) / (0.03 * D + 0.05));\n    s += cq.r * g * wd;\n    w += g * wd;\n  }\n  imageStore(I16[DR.tex.w], ip, vec4(s / w, D, 0.0, 1.0));\n}\n";
var SRC_bloom_down_comp: string = "// THE FRAME, 3a: the glow's chain down (Jimenez, \"Next Generation Post Processing in Call of Duty: Advanced Warfare\"),\n// a compute pass a level: a 13-tap filter to half size; the first step keeps only what's bright (a soft knee) and\n// weights its five blocks by their brightness (the Karis average: a single hot pixel doesn't flicker into a blob).\n// Out: I16[DR.tex.w], DR.p1.zw texels\nlayout(local_size_x = 8, local_size_y = 8) in;\n#define uSrc T2[DR.tex.x]\n#define uTexel DR.p0.xy        // the source's texel\n#define uFirst int(DR.p0.z)\n#define uThreshold DR.p0.w\n#define uKnee DR.p1.x\nfloat lum(vec3 c) {{ return dot(c, vec3(0.2126, 0.7152, 0.0722)); }\nvec3 bright(vec3 c) {{\n  float l = lum(c);\n  float soft = clamp(l - uThreshold + uKnee, 0.0, 2.0 * uKnee);\n  soft = soft * soft / (4.0 * uKnee + 1e-5);\n  return c * max(soft, l - uThreshold) / max(l, 1e-5);\n}\nvec3 tap(vec2 uv) {{\n  vec3 c = textureLod(uSrc, uv, 0.0).rgb;\n  return (any(isnan(c)) || any(isinf(c))) ? vec3(0.0) : clamp(c, 0.0, 30000.0);\n}\nvoid main() {{\n  ivec2 ip = ivec2(gl_GlobalInvocationID.xy);\n  vec2 size = DR.p1.zw;\n  if (ip.x >= int(size.x) || ip.y >= int(size.y)) return;\n  vec2 uv = (vec2(ip) + 0.5) / size;\n  vec2 t = uTexel;\n  vec3 a = tap(uv + t * vec2(-2, 2)), b = tap(uv + t * vec2(0, 2)), c = tap(uv + t * vec2(2, 2));\n  vec3 d = tap(uv + t * vec2(-2, 0)), e = tap(uv), f = tap(uv + t * vec2(2, 0));\n  vec3 g = tap(uv + t * vec2(-2, -2)), h = tap(uv + t * vec2(0, -2)), i = tap(uv + t * vec2(2, -2));\n  vec3 j = tap(uv + t * vec2(-1, 1)), k = tap(uv + t * vec2(1, 1));\n  vec3 l = tap(uv + t * vec2(-1, -1)), m = tap(uv + t * vec2(1, -1));\n  vec3 o;\n  if (uFirst != 0) {{\n    vec3 b0 = bright((j + k + l + m) * 0.25), b1 = bright((a + b + d + e) * 0.25), b2 = bright((b + c + e + f) * 0.25);\n    vec3 b3 = bright((d + e + g + h) * 0.25), b4 = bright((e + f + h + i) * 0.25);\n    float w0 = 1.0 / (1.0 + lum(b0)), w1 = 1.0 / (1.0 + lum(b1)), w2 = 1.0 / (1.0 + lum(b2));\n    float w3 = 1.0 / (1.0 + lum(b3)), w4 = 1.0 / (1.0 + lum(b4));\n    o = (b0 * w0 * 0.5 + (b1 * w1 + b2 * w2 + b3 * w3 + b4 * w4) * 0.125) / (w0 * 0.5 + (w1 + w2 + w3 + w4) * 0.125);\n  } else {{\n    o = e * 0.125 + (a + c + g + i) * 0.03125 + (b + d + f + h) * 0.0625 + (j + k + l + m) * 0.125;\n  }\n  imageStore(I16[DR.tex.w], ip, vec4(o, 1.0));\n}\n";
var SRC_bloom_up_comp: string = "// THE FRAME, 3b: the glow's chain up, a compute pass a level: each smaller level (T2[DR.tex.x]) spread by a 3x3 tent\n// and added onto the one above it (I16[DR.tex.w], DR.p1.zw texels: read, added to, written back), so the glow has\n// every width at once -- a tight core, a wide breath\nlayout(local_size_x = 8, local_size_y = 8) in;\n#define uSrc T2[DR.tex.x]\n#define uTexel DR.p0.xy        // the source's texel\n#define uRadius DR.p0.z\nvoid main() {{\n  ivec2 ip = ivec2(gl_GlobalInvocationID.xy);\n  vec2 size = DR.p1.zw;\n  if (ip.x >= int(size.x) || ip.y >= int(size.y)) return;\n  vec2 uv = (vec2(ip) + 0.5) / size;\n  vec2 t = uTexel * uRadius;\n  vec3 s = textureLod(uSrc, uv, 0.0).rgb * 4.0;\n  s += (textureLod(uSrc, uv + vec2(-t.x, 0), 0.0).rgb + textureLod(uSrc, uv + vec2(t.x, 0), 0.0).rgb\n      + textureLod(uSrc, uv + vec2(0, -t.y), 0.0).rgb + textureLod(uSrc, uv + vec2(0, t.y), 0.0).rgb) * 2.0;\n  s += textureLod(uSrc, uv + vec2(-t.x, -t.y), 0.0).rgb + textureLod(uSrc, uv + vec2(t.x, -t.y), 0.0).rgb\n     + textureLod(uSrc, uv + vec2(-t.x, t.y), 0.0).rgb + textureLod(uSrc, uv + vec2(t.x, t.y), 0.0).rgb;\n  vec4 dst = imageLoad(I16[DR.tex.w], ip);\n  imageStore(I16[DR.tex.w], ip, vec4(dst.rgb + s / 16.0, 1.0));\n}\n";
var SRC_box_frag: string = "// the blocks: cast concrete, weathered -- its colour stained over metres, rain streaked down from the top, the ground's\n// grime soaked up its foot, cracks, pits, the corners chipped paler; its surface from the same: the sand's grain, the\n// pits sunk into it, the cracks' grooves, the cast's corners rounded and chipped (the normal from its height either\n// side, the finest of it fading out before it's finer than a pixel)\nlayout(location = 0) in vec3 vWp; layout(location = 1) in vec3 vN; layout(location = 2) in vec2 vUv;\nlayout(location = 3) in float vCav;  // (static.vert's: 0, the cube has no cavity)\nfloat noise(vec3 p) {{ return n3(p); }\nfloat fbm(vec3 p) {{ float s = 0.0, a = 0.5; for (int i = 0; i < 4; i++) {{ s += a * noise(p); p *= 2.07; a *= 0.5; } return s; }\n// the surface's height (m) along its normal at p; fw: a pixel there\nfloat ht(vec3 p, float fw) {{\n  float h = (noise(p * 140.0) - 0.5) * 0.0006 * (1.0 - smoothstep(0.0015, 0.004, fw));   // (the sand's grain)\n  h += (fbm(p * 9.0) - 0.5) * 0.0016 * (1.0 - smoothstep(0.006, 0.02, fw));\n  float pit = smoothstep(0.9, 0.96, noise(p * 120.0));\n  h -= pit * 0.0005 * (1.0 - smoothstep(0.0015, 0.005, fw));\n  float cr = abs(fbm(p * 1.7 + vec3(3.1, 0.0, 7.7)) - 0.5);\n  h -= 0.0008 * (1.0 - smoothstep(0.0, 0.012, cr)) * smoothstep(0.45, 0.6, noise(p * 0.8 + 11.0)) * (1.0 - smoothstep(0.006, 0.02, fw));\n  return h;\n}\nvoid main() {{\n  vec3 n0 = normalize(vN);\n  vec3 p = vWp;\n  float fw = max(length(fwidth(p)), 1e-4);\n  // ---- its colour (linear albedo)\n  vec3 tint = lin(mix(uTint, vec3(0.62, 0.60, 0.56), 0.5));\n  float stain = fbm(p * 0.55);\n  float streak = fbm(vec3(p.x * 7.0, p.y * 0.45, p.z * 7.0));      // (the rain's runs: long down, fine across)\n  float top = smoothstep(0.0, 1.2, p.y);\n  float grime = 1.0 - smoothstep(0.0, 0.85, p.y + (noise(p * 2.2) - 0.5) * 0.35);\n  float cr = abs(fbm(p * 1.7 + vec3(3.1, 0.0, 7.7)) - 0.5);\n  float crack = (1.0 - smoothstep(0.0, 0.006, cr)) * smoothstep(0.5, 0.65, noise(p * 0.8 + 11.0));\n  float pit = smoothstep(0.9, 0.96, noise(p * 120.0));\n  vec3 alb = tint * (0.62 + 0.5 * stain) * (0.9 + 0.2 * noise(p * 23.0));\n  alb *= 1.0 - 0.38 * smoothstep(0.45, 0.75, streak) * top;\n  alb = mix(alb, alb * vec3(0.42, 0.36, 0.29), grime * 0.7);\n  alb *= 1.0 - 0.06 * crack - 0.06 * pit;\n  vec2 e2 = min(vUv, 1.0 - vUv);\n  float edge = 1.0 - smoothstep(0.0, 0.035, min(e2.x, e2.y) + (noise(p * 9.0) - 0.5) * 0.03);\n  alb = mix(alb, tint * 1.3, edge * 0.45);\n  float occ = (1.0 - 0.12 * pit) * (1.0 - 0.75 * vCav);\n  // ---- its surface: across the face (t1, t2), the height either side\n  vec3 an = abs(n0);\n  vec3 t1 = an.x > 0.5 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);\n  vec3 t2 = an.y > 0.5 ? vec3(0.0, 0.0, 1.0) : vec3(0.0, 1.0, 0.0);\n  float e = clamp(fw * 0.6, 0.0008, 0.03);\n  float h0 = ht(p, fw);\n  float h1 = ht(p + t1 * e, fw);\n  float h2 = ht(p + t2 * e, fw);\n  vec3 n = normalize(n0 - t1 * (h1 - h0) / e - t2 * (h2 - h0) / e);\n  // (its corners rounded: the normal turned toward the edge it's near)\n  vec2 toE = vec2(vUv.x < 0.5 ? -1.0 : 1.0, vUv.y < 0.5 ? -1.0 : 1.0);\n  float ex = 1.0 - smoothstep(0.0, 0.012, e2.x), ey = 1.0 - smoothstep(0.0, 0.012, e2.y);\n  vec3 dUx = dFdx(p) * dFdx(vUv).x + dFdy(p) * dFdy(vUv).x;          // (the face's u, v in the world)\n  vec3 dUy = dFdx(p) * dFdx(vUv).y + dFdy(p) * dFdy(vUv).y;\n  if (dot(dUx, dUx) > 1e-12) n = normalize(n + normalize(dUx) * toE.x * ex * 0.5);\n  if (dot(dUy, dUy) > 1e-12) n = normalize(n + normalize(dUy) * toE.y * ey * 0.5);\n  float rough = mix(0.9, 0.97, stain) - 0.12 * grime;\n  writeG(alb, occ, n, rough, 0.0, vec3(0.0), vWp);\n}\n";
var SRC_common_glsl: string = "// THE G-BUFFER: what every scene shader writes -- the surface, not its light (that's shaders/shade.frag's, once a pixel\n// after): its albedo, its normal, how rough and how metal it is, what it is and how far, the light it gives off\n// (uCamPos, uObj, uClass: the prelude's)\nlayout(location = 0) out vec4 gAlb;    // albedo (sRGB-encoded), a: its occlusion (creases, seams; 1 open)\nlayout(location = 1) out vec4 gNrm;    // world normal, a: roughness (perceptual: 0 a mirror .. 1)\nlayout(location = 2) out vec4 gObj;    // object id, class, metalness, distance (m)\nlayout(location = 3) out vec4 gEmi;    // the light it gives off (sRGB-encoded, an eighth of it), a: how much light it\n                                       // carries under its surface (flesh: 0 none)\n\nvec3 lin(vec3 c) {{ return pow(max(c, vec3(0.0)), vec3(2.2)); }\nvec3 enc(vec3 c) {{ return pow(clamp(c, 0.0, 1.0), vec3(1.0 / 2.2)); }\nfloat h3(vec3 p) {{ return fract(sin(dot(p, vec3(12.9898, 78.233, 37.719))) * 43758.5453); }\nfloat n3(vec3 p) {{\n  vec3 i = floor(p), f = fract(p); f = f * f * (3.0 - 2.0 * f);\n  return mix(mix(mix(h3(i), h3(i + vec3(1,0,0)), f.x), mix(h3(i + vec3(0,1,0)), h3(i + vec3(1,1,0)), f.x), f.y),\n             mix(mix(h3(i + vec3(0,0,1)), h3(i + vec3(1,0,1)), f.x), mix(h3(i + vec3(0,1,1)), h3(i + vec3(1,1,1)), f.x), f.y), f.z);\n}\n// a tight curve's normals spread over the pixel widen its highlight (Kaplanyan's specular antialiasing: no sparkle on\n// the edges, the seams, the normal map's grain)\nfloat specAA(vec3 n, float r) {{\n  vec3 du = dFdx(n), dv = dFdy(n);\n  float k = min(0.5 * (dot(du, du) + dot(dv, dv)), 0.18);\n  return sqrt(clamp(r * r + k, 0.0, 1.0));\n}\nvoid writeGs(vec3 albedo, float occ, vec3 n, float rough, float metal, vec3 emit, vec3 wp, float sss) {{\n  gAlb = vec4(enc(albedo), occ);\n  gNrm = vec4(n, specAA(n, clamp(rough, 0.02, 1.0)));\n  gObj = vec4(uObj, uClass, metal, length(uCamPos - wp));\n  gEmi = vec4(enc(emit / 8.0), clamp(sss, 0.0, 1.0));\n}\nvoid writeG(vec3 albedo, float occ, vec3 n, float rough, float metal, vec3 emit, vec3 wp) {{\n  writeGs(albedo, occ, n, rough, metal, emit, wp, 0.0);\n}\n// the tangent frame from the screen's derivatives (Schuler, \"Normal Mapping Without Precomputed Tangents\"): a normal\n// map read without tangents baked into the mesh\nmat3 cotangentFrame(vec3 N, vec3 p, vec2 uv) {{\n  vec3 dp1 = dFdx(p), dp2 = dFdy(p);\n  vec2 duv1 = dFdx(uv), duv2 = dFdy(uv);\n  vec3 dp2perp = cross(dp2, N), dp1perp = cross(N, dp1);\n  vec3 T = dp2perp * duv1.x + dp1perp * duv2.x;\n  vec3 B = dp2perp * duv1.y + dp1perp * duv2.y;\n  float im = inversesqrt(max(max(dot(T, T), dot(B, B)), 1e-20));\n  return mat3(T * im, B * im, N);\n}\n";
var SRC_depth_frag: string = "// the shadow map's depth (the extension: RX_DEPTH_FS -- what to leave out of it)\n#pragma ext\nvoid main() {{ ext_fragment(); }\n";
var SRC_ext_depth_glsl: string = "// the default extension: nothing left out of the shadow map\nvoid ext_fragment() {{}\n";
var SRC_ext_final_glsl: string = "// the default extension: nothing between the lens and the scene\nvec2 ext_final_offset(ivec2 ip, vec2 uv) {{ return vec2(0.0); }\nvec3 ext_final(vec3 c, vec2 uv) {{ return c; }\n";
var SRC_ext_light_glsl: string = "// the default extension: nothing laid over the surfaces before they're lit\nvoid ext_light_pre(vec3 wp, vec3 N, int cls, float D, vec3 dpx, vec3 dpy) {{}\nvoid ext_light_surface(vec3 wp, int cls, vec3 dpx, vec3 dpy, inout vec3 base, inout float rough, inout float metal, inout vec3 N) {{}\nfloat ext_light_mirror() {{ return 0.0; }\nfloat ext_light_ground_mask() {{ return 0.0; }\nvec3 ext_light_extra() {{ return vec3(0.0); }\n";
var SRC_ext_surface_glsl: string = "// the default extension: the surface as the mesh has it\nvoid ext_clip() {{}\nvoid ext_surface(vec3 tc, inout vec3 alb, inout float rough, inout float metal, inout float occ, inout vec3 emit, inout float H) {{}\n";
var SRC_ext_vertex_glsl: string = "// the default extensions: nothing added (a game passes its own to render_ext before render_init)\nvoid ext_vertex() {{}\n";
var SRC_final_comp: string = "// THE FRAME, 3: the lens and the film, a compute pass -- the scene's light (HDR) as a camera would take it:\n//   the glow      the bloom chain (shaders/bloom_*): a little of the light spread at every width, as a lens does\n//   the extension what the game puts between the lens and the scene (RX_FINAL_FS): where each pixel is seen from\n//                 (ext_final_offset), then the scene's light changed (ext_final)\n//   the exposure  then Reinhard's operator (extended, on luminance) and the sRGB curve\n//   the lens      its corners a little darker; a fine grain over it\n// Out (I8[DR.tex.w]): the display colour, a: its luma (for FXAA).\nlayout(local_size_x = 8, local_size_y = 8) in;\n#define uHdrT T2[DR.tex.x]     // the scene's light\n#define uBloomT T2[DR.tex.y]   // the glow's chain (half size, every level summed)\n\nconst vec3 L3 = vec3(0.2126, 0.7152, 0.0722);\n// REINHARD (Reinhard et al. 2002, extended): the scene's luminance L to the display's, L (1 + L / W^2) / (1 + L) --\n// the darks and the mids near as they are, the lights rolled off toward white, reaching it at W; the colour scaled\n// with its luminance (its hue held), what goes past 1 in a channel clipped; then the sRGB curve\nconst float WHITE = 6.0;\nvec3 reinhard(vec3 c) {{\n  float L = dot(c, L3);\n  float Ld = L * (1.0 + L / (WHITE * WHITE)) / (1.0 + L);\n  return clamp(c * (Ld / max(L, 1e-6)), 0.0, 1.0);\n}\nvec3 srgb(vec3 c) {{ return mix(c * 12.92, 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055, step(0.0031308, c)); }\n#pragma ext\n\n\nvoid main() {{\n  ivec2 ip = ivec2(gl_GlobalInvocationID.xy);\n  if (ip.x >= int(uScreen.x) || ip.y >= int(uScreen.y)) return;\n  vec2 fc = vec2(ip) + 0.5;\n  vec2 uv = fc / uScreen;\n  vec2 suv = clamp(uv + ext_final_offset(ip, uv), vec2(0.0), vec2(1.0));\n  vec3 c = textureLod(uHdrT, suv, 0.0).rgb;\n  if (any(isnan(c)) || any(isinf(c))) c = vec3(0.0);\n  // the glow: a little of every width of it (the chain sums its six levels)\n  vec3 bloom = textureLod(uBloomT, suv, 0.0).rgb / 6.0;\n  c = mix(c, bloom, uBloom);\n  c = ext_final(c, uv);\n  // the lens: its corners darker (natural vignetting, gentle)\n  vec2 uvc = uv - 0.5;\n  float vig = dot(uvc * vec2(uScreen.x / uScreen.y, 1.0), uvc * vec2(uScreen.x / uScreen.y, 1.0));\n  c *= 1.0 / (1.0 + vig * 0.55);\n  vec3 d = srgb(reinhard(c * uExposure));\n  // the film's grain, faint, finer in the lights\n  float gn = fract(sin(dot(fc + floor(uTime * 24.0) * vec2(17.3, 41.9), vec2(12.9898, 78.233))) * 43758.5453);\n  d += (gn - 0.5) * 0.012 * (1.0 - 0.6 * dot(d, L3));\n  d = clamp(d, 0.0, 1.0);\n  imageStore(I8[DR.tex.w], ip, vec4(d, dot(d, vec3(0.299, 0.587, 0.114))));\n}\n";
var SRC_fx_frag: string = "// a soft-edged streak / blob: uv in -1..1 across it; additive\nlayout(location = 0) in vec2 vUv; layout(location = 1) in vec4 vCol;\nlayout(location = 0) out vec4 oCol;\nvoid main() {{\n  float r = length(vUv);\n  float a = vCol.a * clamp(1.0 - r, 0.0, 1.0);\n  a *= a;\n  oCol = vec4(vCol.rgb * a, a);\n}\n";
var SRC_fx_vert: string = "// tracers, flashes, puffs: world-space quads built on the CPU, already facing the camera (DR.verts: as the HUD's)\nlayout(location = 0) out vec2 vUv; layout(location = 1) out vec4 vCol;\nvoid main() {{\n  Floats V = Floats(DR.verts);\n  uint o = uint(gl_VertexIndex) * 9u;\n  vec3 p = vec3(V.f[o], V.f[o + 1u], V.f[o + 2u]);\n  vUv = vec2(V.f[o + 3u], V.f[o + 4u]);\n  vCol = vec4(V.f[o + 5u], V.f[o + 6u], V.f[o + 7u], V.f[o + 8u]);\n  gl_Position = vkClip(uViewProj * vec4(p, 1.0));\n}\n";
var SRC_fxaa_comp: string = "// FXAA (Lottes), a compute pass: the frame's edges smoothed -- the luma's gradient across each pixel finds the edge's\n// direction, two taps along it either side blend it, kept only if they don't overshoot the neighbourhood's range.\n// Out: I8[DR.tex.w]\nlayout(local_size_x = 8, local_size_y = 8) in;\n#define uSrc T2[DR.tex.x]      // the display colour, a: its luma\nvec4 tx(vec2 uv) {{ return textureLod(uSrc, uv, 0.0); }\nvoid main() {{\n  ivec2 ip = ivec2(gl_GlobalInvocationID.xy);\n  if (ip.x >= int(uScreen.x) || ip.y >= int(uScreen.y)) return;\n  vec2 rcp = 1.0 / uScreen;\n  vec2 uv = (vec2(ip) + 0.5) * rcp;\n  float lNW = tx(uv + vec2(-1.0, -1.0) * rcp).a;\n  float lNE = tx(uv + vec2(1.0, -1.0) * rcp).a;\n  float lSW = tx(uv + vec2(-1.0, 1.0) * rcp).a;\n  float lSE = tx(uv + vec2(1.0, 1.0) * rcp).a;\n  vec4 M = tx(uv);\n  float lM = M.a;\n  float lMin = min(lM, min(min(lNW, lNE), min(lSW, lSE)));\n  float lMax = max(lM, max(max(lNW, lNE), max(lSW, lSE)));\n  if (lMax - lMin < max(0.0312, lMax * 0.125)) {{ imageStore(I8[DR.tex.w], ip, vec4(M.rgb, 1.0)); return; }\n  vec2 dir = vec2(-((lNW + lNE) - (lSW + lSE)), (lNW + lSW) - (lNE + lSE));\n  float red = max((lNW + lNE + lSW + lSE) * 0.25 * 0.125, 1.0 / 128.0);\n  float rmin = 1.0 / (min(abs(dir.x), abs(dir.y)) + red);\n  dir = clamp(dir * rmin, vec2(-8.0), vec2(8.0)) * rcp;\n  vec3 A = 0.5 * (tx(uv + dir * (1.0 / 3.0 - 0.5)).rgb + tx(uv + dir * (2.0 / 3.0 - 0.5)).rgb);\n  vec3 B = A * 0.5 + 0.25 * (tx(uv - dir * 0.5).rgb + tx(uv + dir * 0.5).rgb);\n  float lB = dot(B, vec3(0.299, 0.587, 0.114));\n  imageStore(I8[DR.tex.w], ip, vec4((lB < lMin || lB > lMax) ? A : B, 1.0));\n}\n";
var SRC_ground_frag: string = "// the ground: a dry yard of packed dirt -- its colour mottled over metres and centimetres (sun-bleached, damp darker in\n// the hollows), patches of dry grass, a fine grain of sand in it; its surface from the same: the lie of the land, the\n// small clods and ruts of trodden dirt, the grit (the normal from its height either side, the finest of it fading out\n// before it's finer than a pixel)\nlayout(location = 0) in vec3 vWp;\nfloat hash(vec2 p) {{ vec3 q = fract(vec3(p.xyx) * 0.1031); q += dot(q, q.yzx + 33.33); return fract((q.x + q.y) * q.z); }\nfloat noise(vec2 p) {{\n  vec2 i = floor(p), f = fract(p); f = f * f * (3.0 - 2.0 * f);\n  return mix(mix(hash(i), hash(i + vec2(1, 0)), f.x), mix(hash(i + vec2(0, 1)), hash(i + vec2(1, 1)), f.x), f.y);\n}\nfloat fbm(vec2 p, int oct) {{\n  float s = 0.0, a = 0.5;\n  for (int i = 0; i < 6; i++) {{ if (i >= oct) break; s += a * noise(p); p = p * 2.03 + 17.1; a *= 0.5; }\n  return s;\n}\n// the ground's height (m) at p; fw: a pixel there (the detail finer than that left out)\nfloat ht(vec2 p, float fw) {{\n  float h = (fbm(p * 0.35, 4) - 0.5) * 0.05;                       // the lie of the land: a few cm over metres\n  h += (fbm(p * 2.2, 4) - 0.5) * 0.007 * (1.0 - smoothstep(0.02, 0.07, fw));          // (ruts, trodden lumps)\n  h += (fbm(p * 11.0, 3) - 0.5) * 0.0028 * (1.0 - smoothstep(0.006, 0.02, fw));       // (small clods)\n  h += (noise(p * 52.0) - 0.5) * 0.0011 * (1.0 - smoothstep(0.002, 0.007, fw));      // (the grit)\n  return h;\n}\nvoid main() {{\n  vec2 p = vWp.xz;\n  float fw = max(length(fwidth(p)), 1e-4);\n  // ---- its colour (linear albedo)\n  float m = fbm(p * 0.08, 5);\n  float big = fbm(p * 0.35, 5);\n  float fine = fbm(p * 2.4, 4);\n  vec3 dirt = vec3(0.235, 0.185, 0.135) * (0.72 + 0.5 * big) * (0.88 + 0.24 * fine);\n  dirt = mix(dirt, dirt * vec3(1.06, 0.98, 0.9), smoothstep(0.4, 0.7, fbm(p * 0.6 + 9.0, 3)));   // (sun-bleached)\n  float clump = smoothstep(0.50, 0.66, m + (fbm(p * 1.3, 4) - 0.5) * 0.5);\n  vec3 grass = mix(vec3(0.11, 0.115, 0.045), vec3(0.24, 0.21, 0.09), fbm(p * 3.0, 4)) * (0.7 + 0.6 * noise(p * 11.0));\n  vec3 alb = mix(dirt, grass, clump);\n  float hollow = smoothstep(0.55, 0.75, fbm(p * 0.22 + 5.0, 4));\n  alb *= 1.0 - 0.3 * hollow;                                       // (damp: darker)\n  // (the sand's grain: each speck its own shade, gone before it's finer than a pixel)\n  alb *= 1.0 + (noise(p * 140.0) - 0.5) * 0.22 * (1.0 - smoothstep(0.0015, 0.005, fw));\n  alb *= 1.0 + (noise(p * 31.0) - 0.5) * 0.16 * (1.0 - smoothstep(0.005, 0.02, fw));\n  float occ = 1.0 - 0.2 * hollow;\n  // ---- its surface\n  float e = clamp(fw * 0.6, 0.0015, 0.05);\n  float h0 = ht(p, fw);\n  float hx = ht(p + vec2(e, 0.0), fw);\n  float hz = ht(p + vec2(0.0, e), fw);\n  vec3 n = normalize(vec3(-(hx - h0) / e, 1.0, -(hz - h0) / e));\n  float rough = mix(0.96, 0.88, clump);\n  rough = mix(rough, 0.9, hollow * 0.5);\n  writeG(alb, occ, n, rough, 0.0, vec3(0.0), vWp);\n}\n";
var SRC_ground_vert: string = "// the ground: one big quad, 600 m each way (the grid and the noise are the shader's)\nlayout(location = 0) out vec3 vWp;\nconst vec2 G[6] = vec2[6](vec2(-1.0, -1.0), vec2(-1.0, 1.0), vec2(1.0, 1.0), vec2(-1.0, -1.0), vec2(1.0, 1.0), vec2(1.0, -1.0));\nvoid main() {{\n  vec2 g = G[gl_VertexIndex] * 600.0;\n  vWp = vec3(g.x, 0.0, g.y);\n  gl_Position = vkClip(uViewProj * vec4(vWp, 1.0));\n}\n";
var SRC_hud_frag: string = "layout(location = 0) in vec2 vUv; layout(location = 1) in vec4 vCol;\n#define uFont T2[DR.tex.x]\nlayout(location = 0) out vec4 oCol;\nvoid main() {{\n  float a = vUv.x < 0.0 ? 1.0 : texture(uFont, vUv).a;\n  oCol = vec4(vCol.rgb, vCol.a * a);\n}\n";
var SRC_hud_vert: string = "// the screen's quads, in pixels from the top left (DR.verts: 9 floats a vertex -- x y z, u v, r g b a)\nlayout(location = 0) out vec2 vUv; layout(location = 1) out vec4 vCol;\nvoid main() {{\n  Floats V = Floats(DR.verts);\n  uint o = uint(gl_VertexIndex) * 9u;\n  vec3 p = vec3(V.f[o], V.f[o + 1u], V.f[o + 2u]);\n  vUv = vec2(V.f[o + 3u], V.f[o + 4u]);\n  vCol = vec4(V.f[o + 5u], V.f[o + 6u], V.f[o + 7u], V.f[o + 8u]);\n  gl_Position = vkClip(vec4(p.x / uScreen.x * 2.0 - 1.0, 1.0 - p.y / uScreen.y * 2.0, 0.0, 1.0));\n}\n";
var SRC_shade_frag: string = "// THE FRAME, 2: the light -- once a pixel, from the G-buffer, physically: every surface's albedo, normal, roughness\n// and metalness lit by\n//   the sun      a low warm sun, its light through two cascades of shadow map (soft-edged: sixteen taps on a rotated\n//                disc), Lambert's diffuse and a GGX highlight (Smith's visibility, Schlick's Fresnel)\n//   the sky      the game's own sky (its gradient, the sun's glow) as the light from everywhere else: the sky above,\n//                the ground's bounce below (diffuse), the sky reflected along the mirror direction, blurred with\n//                roughness (the split-sum's analytic fit), both shut out where the surface is occluded (ambient\n//                occlusion, shaders/ao.frag, and the material's own creases)\n//   the air      the haze with distance, lit toward the sun\n// the extension (RX_LIGHT_FS) lays what it will over each surface before it's lit (ext_light_pre, before the sky's\n// pixels leave -- their derivatives need every pixel; ext_light_surface), says where the surface is a mirror for the\n// scene (ext_light_mirror: screen-space reflection off last frame), and adds light of its own (ext_light_extra).\n// FLESH carries the light under its surface and gives it out red: its sun wraps past the terminator (the red furthest,\n// the blue least), its creases not as dark\n// The sky pixels: the sky itself.\n// Out: the scene's light (HDR, linear).\n// (the frame's -- the cascades, the camera, the sun's and the sky's light, the haze -- are the prelude's)\nlayout(location = 0) in vec2 vNdc;\n#define uAlbT T2[DR.tex.x]     // albedo (sRGB), occlusion\n#define uNrmT T2[DR.tex.y]     // normal, roughness\n#define uObjT T2[DR.tex.z]     // id, class, metalness, distance\n#define uEmiT T2[DR.tex.w]     // the light given off (sRGB, an eighth)\n#define uDepthT T2[DR.tex2.x]\n#define uAOT T2[DR.tex2.y]     // ambient occlusion (shaders/ao.comp, blurred)\n#define uPrevT T2[DR.tex2.z]   // last frame's light (what the wet surfaces reflect)\n#define uShadow TS[DR.tex2.w]  // the sun's shadow map: two cascades side by side\nlayout(location = 0) out vec4 oC;\n\nconst float PI = 3.14159265;\nvec3 lin(vec3 c) {{ return pow(max(c, vec3(0.0)), vec3(2.2)); }\nivec2 clampPx(ivec2 p) {{ return clamp(p, ivec2(0), ivec2(uScreen) - 1); }\nfloat ign(vec2 p) {{ return fract(52.9829189 * fract(dot(p, vec2(0.06711056, 0.00583715)))); }\n\n// ---------------------------------------------------------------- the sky\n// the game's own sky (its gradient, the haze at the horizon, the ground below it, the sun's glow; disc: its disc too)\nvec3 skyL(vec3 d, float disc) {{\n  float h = d.y;\n  vec3 zen = vec3(0.16, 0.30, 0.62);\n  vec3 hor = vec3(0.86, 0.74, 0.58);\n  vec3 c = mix(hor, zen, pow(clamp(h, 0.0, 1.0), 0.45));\n  c = mix(c, uFogCol, clamp(1.0 - h * 6.0, 0.0, 1.0) * 0.6);\n  if (h < 0.0) c = mix(uFogCol, uGndCol * 0.6, clamp(-h * 4.0, 0.0, 1.0));\n  float s = max(dot(d, uSunDir), 0.0);\n  c += uSunCol * (pow(s, 900.0) * 6.0 * disc + pow(s, 12.0) * 0.12);\n  return c;\n}\n\n// ---------------------------------------------------------------- the sun's shadow\nconst vec2 POISSON[16] = vec2[16](\n  vec2(-0.94201624, -0.39906216), vec2(0.94558609, -0.76890725), vec2(-0.09418410, -0.92938870), vec2(0.34495938, 0.29387760),\n  vec2(-0.91588581, 0.45771432), vec2(-0.81544232, -0.87912464), vec2(-0.38277543, 0.27676845), vec2(0.97484398, 0.75648379),\n  vec2(0.44323325, -0.97511554), vec2(0.53742981, -0.47373420), vec2(-0.26496911, -0.41893023), vec2(0.79197514, 0.19090188),\n  vec2(-0.24188840, 0.99706507), vec2(-0.81409955, 0.91437590), vec2(0.19984126, 0.78641367), vec2(0.14383161, -0.14100790));\n// cascade k at wp (pushed out along its normal by its texels): -1 off it, else how much of the sun reaches\nfloat cascade(int k, vec3 wp, vec3 n, float ndl, float rot) {{\n  float tx = k == 0 ? uCascTexel.x : uCascTexel.y;\n  vec3 q = wp + n * tx * (1.2 + 2.5 * (1.0 - ndl));\n  vec4 lp = (k == 0 ? uLightVP0 : uLightVP1) * vec4(q, 1.0);\n  vec3 c = lp.xyz / lp.w * 0.5 + 0.5;\n  if (c.x < 0.02 || c.x > 0.98 || c.y < 0.02 || c.y > 0.98 || c.z > 1.0) return -1.0;\n  float bias = (k == 0 ? 0.00006 : 0.00025);\n  float rad = k == 0 ? 1.9 : 1.4;\n  vec2 ts = vec2(1.0 / 4096.0, 1.0 / 2048.0) * rad;\n  float cs = cos(rot), sn = sin(rot);\n  float s = 0.0;\n  for (int i = 0; i < 16; i++) {{\n    vec2 o = vec2(cs * POISSON[i].x - sn * POISSON[i].y, sn * POISSON[i].x + cs * POISSON[i].y);\n    s += texture(uShadow, vec3(vec2((c.x + float(k)) * 0.5, c.y) + o * ts, c.z - bias));\n  }\n  return s / 16.0;\n}\nfloat sunShadow(vec3 wp, vec3 n, float ndl, float rot) {{\n  float s0 = cascade(0, wp, n, ndl, rot);\n  float s1 = cascade(1, wp, n, ndl, rot);\n  if (s0 < 0.0) return s1 < 0.0 ? 1.0 : s1;\n  // (across the near cascade's last stretch, into the far one)\n  vec4 lp = uLightVP0 * vec4(wp, 1.0);\n  vec2 c = abs(lp.xy / lp.w);\n  float edge = smoothstep(0.82, 0.94, max(c.x, c.y));\n  return s1 < 0.0 ? s0 : mix(s0, s1, edge);\n}\n\n// ---------------------------------------------------------------- the surface's response\nfloat D_GGX(float nh, float a) {{ float a2 = a * a; float d = nh * nh * (a2 - 1.0) + 1.0; return a2 / (PI * d * d); }\nfloat V_Smith(float nv, float nl, float a) {{\n  float a2 = a * a;\n  float gv = nl * sqrt(nv * nv * (1.0 - a2) + a2);\n  float gl = nv * sqrt(nl * nl * (1.0 - a2) + a2);\n  return 0.5 / max(gv + gl, 1e-5);\n}\nvec3 F_Schlick(vec3 f0, float vh) {{ return f0 + (1.0 - f0) * pow(1.0 - vh, 5.0); }\n// the split-sum's environment term, fitted (Karis / Lazarov): its scale and bias on F0\nvec2 envBRDF(float nv, float r) {{\n  const vec4 c0 = vec4(-1.0, -0.0275, -0.572, 0.022);\n  const vec4 c1 = vec4(1.0, 0.0425, 1.04, -0.04);\n  vec4 r4 = r * c0 + c1;\n  float a004 = min(r4.x * r4.x, exp2(-9.28 * nv)) * r4.x + r4.y;\n  return vec2(-1.04, 1.04) * a004 + r4.zw;\n}\n// the sky's light from all round a normal (diffuse irradiance over pi): the sky above, the ground's bounce below\nvec3 skyIrr(vec3 n) {{ return mix(uGndCol, uSkyCol, n.y * 0.5 + 0.5); }\n// the sky along the mirror direction r, blurred as the surface is rough\nvec3 skyRefl(vec3 r, float rough) {{\n  vec3 sharp = skyL(r, 0.0);\n  return mix(sharp, skyIrr(r) * 1.1, smoothstep(0.15, 0.85, rough));\n}\n\n// the scene reflected along r from p: a march in screen space against this frame's depth, the light where it lands\n// taken from last frame (where that point was on it); else the sky that way\nvec3 reflection(vec3 p, vec3 r, float rough) {{\n  float t = 0.04;\n  for (int i = 0; i < 26; i++) {{\n    vec3 x = p + r * t;\n    vec4 cl = uVP * vec4(x, 1.0);\n    if (cl.w <= 0.0) break;\n    vec2 uv = cl.xy / cl.w * 0.5 + 0.5;\n    if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0) break;\n    ivec2 q = ivec2(uv * uScreen);\n    float sd = texelFetch(uObjT, q, 0).w;\n    float rd = distance(x, uCamPos);\n    if (sd < 900.0 && rd > sd + 0.01 && rd < sd + max(0.25, t * 0.3)) {{\n      vec4 pc = uPrevVP * vec4(x, 1.0);\n      vec2 pv = pc.xy / pc.w * 0.5 + 0.5;\n      vec2 e = smoothstep(vec2(0.0), vec2(0.07), uv) * smoothstep(vec2(1.0), vec2(0.93), uv);\n      vec3 sky = skyRefl(r, rough);\n      if (pc.w <= 0.0 || pv.x < 0.0 || pv.x > 1.0 || pv.y < 0.0 || pv.y > 1.0) return sky;\n      return mix(sky, texture(uPrevT, pv).rgb, e.x * e.y);\n    }\n    t *= 1.32;\n  }\n  return skyRefl(r, rough);\n}\n\n#pragma ext\n\nvoid main() {{\n  ivec2 ip = ivec2(gl_FragCoord.xy);\n  vec4 ob = texelFetch(uObjT, ip, 0);\n  float D = ob.w;\n  int cls = int(ob.y + 0.5);\n  vec4 ra = uInvVP * vec4(vNdc, -1.0, 1.0);\n  vec4 rb = uInvVP * vec4(vNdc, 1.0, 1.0);\n  vec3 vd = normalize(rb.xyz / rb.w - ra.xyz / ra.w);          // (the view ray, out from the eye)\n  float dz = texelFetch(uDepthT, ip, 0).r;\n  vec4 wq = uInvVP * vec4(vNdc, dz * 2.0 - 1.0, 1.0);\n  vec3 wp = wq.xyz / wq.w;\n  vec3 dpx = dFdx(wp), dpy = dFdy(wp);\n  vec4 al = texelFetch(uAlbT, ip, 0);\n  vec4 nr = texelFetch(uNrmT, ip, 0);\n  vec3 N = normalize(nr.xyz + 1e-6);\n  vec3 base = lin(al.rgb);\n  float rough = nr.w;\n  float metal = ob.z;\n  float occ = al.a * texelFetch(uAOT, ip, 0).r;\n  vec4 em = texelFetch(uEmiT, ip, 0);\n  vec3 emit = lin(em.rgb) * 8.0;\n  float sss = em.a;\n  ext_light_pre(wp, N, cls, D, dpx, dpy);\n  if (D > 900.0) {{ oC = vec4(skyL(vd, 1.0), 1.0); return; }\n  ext_light_surface(wp, cls, dpx, dpy, base, rough, metal, N);\n  // ---- the light\n  vec3 V = -vd;\n  float nv = max(dot(N, V), 1e-4);\n  vec3 f0 = mix(vec3(0.04), base, metal);\n  vec3 dif = base * (1.0 - metal);\n  float a = max(rough * rough, 0.002);\n  // the sun\n  float ndl = dot(N, uSunDir);\n  vec3 c = vec3(0.0);\n  vec3 ww = vec3(0.6, 0.24, 0.16) * sss;                          // (the wrap: flesh's red reaches round furthest)\n  vec3 dl = clamp((ndl + ww) / (1.0 + ww), 0.0, 1.0);\n  if (dl.r > 0.0) {{\n    float nl = max(ndl, 0.0);\n    float sh = sunShadow(wp, N, max(ndl, 0.05), ign(gl_FragCoord.xy) * 6.2831853);\n    vec3 H = normalize(uSunDir + V);\n    float nh = max(dot(N, H), 0.0);\n    float vh = max(dot(V, H), 0.0);\n    vec3 F = F_Schlick(f0, vh);\n    float as = max(a, 0.004);                                    // (the sun's a disc, not a point: no infinite glint)\n    vec3 spec = nl > 0.0 ? D_GGX(nh, as) * V_Smith(nv, nl, as) * F : vec3(0.0);\n    // (the sun's irradiance: pi x its colour -- Lambert's 1 / pi cancels it on the diffuse)\n    c += (dif * (1.0 - F) * dl + spec * PI * nl) * uSunCol * sh;\n  }\n  // the sky: diffuse from all round, the reflection along the mirror direction -- both shut out by the occlusion\n  vec2 ab = envBRDF(nv, rough);\n  vec3 Fe = f0 * ab.x + ab.y;\n  vec3 docc = mix(vec3(occ), sqrt(vec3(occ)) * vec3(1.0, 0.8, 0.75), sss);   // (light under flesh's creases)\n  c += dif * skyIrr(N) * docc * (1.0 - Fe);\n  vec3 R = reflect(vd, N);\n  float so = clamp(pow(nv + occ, exp2(-16.0 * rough - 1.0)) - 1.0 + occ, 0.0, 1.0);   // (Lagarde's specular occlusion)\n  vec3 env = ext_light_mirror() > 0.01 ? reflection(wp + N * 0.01, R, rough) : skyRefl(R, rough);\n  if (R.y < 0.0) env = mix(env, uGndCol * 0.9, clamp(-R.y * 3.0, 0.0, 1.0) * (1.0 - ext_light_ground_mask()));   // (the ground, not the sky)\n  c += env * Fe * so;\n  c += ext_light_extra();\n  c += emit;\n  // ---- the air: the haze with distance, lit toward the sun\n  float fog = 1.0 - exp(-max(D - 6.0, 0.0) * uFogDen);\n  vec3 fogC = uFogCol + uSunCol * 0.22 * pow(max(dot(vd, uSunDir), 0.0), 6.0);\n  c = mix(c, fogC, clamp(fog, 0.0, 1.0));\n  // (never past what a half float holds, never not a number: one bad pixel would spread through the glow's chain)\n  if (any(isnan(c)) || any(isinf(c))) c = vec3(0.0);\n  oC = vec4(min(c, vec3(30000.0)), 1.0);\n}\n";
var SRC_skin_vert: string = "// a skinned mesh: four bones a vertex, the palette in the model's space, the mesh's frame on top. Its vertices pulled\n// from the mesh's buffer (DR.verts: 11 words each -- position, normal, uv, joints, weights, shade). The game's extension\n// (#pragma ext, RX_SKIN_VS) may set MAX_BONES and adds ext_vertex(): its own varyings (location 8 and up), from the\n// same inputs (aPos ... aShade, set before it's called)\nlayout(location = 0) out vec3 vWp; layout(location = 1) out vec3 vN; layout(location = 2) out vec2 vUv;\nlayout(location = 3) out float vCav;\nvec3 aPos; vec3 aNrm; vec2 aUv; vec4 aJnt; vec4 aWgt;\nvec4 aShade;                   // x: the cel's cavity (the bake's shade_normals); aNrm is the cel's shading normal\n#pragma ext\n#ifndef MAX_BONES\n#define MAX_BONES 64\n#endif\n#define uBones Mats(DR.bones).m\nvoid skinVertex() {{\n  Uints V = Uints(DR.verts);\n  uint o = uint(gl_VertexIndex) * 11u;\n  aPos = uintBitsToFloat(uvec3(V.u[o], V.u[o + 1u], V.u[o + 2u]));\n  aNrm = uintBitsToFloat(uvec3(V.u[o + 3u], V.u[o + 4u], V.u[o + 5u]));\n  aUv = uintBitsToFloat(uvec2(V.u[o + 6u], V.u[o + 7u]));\n  uint j = V.u[o + 8u];\n  aJnt = vec4(float(j & 255u), float((j >> 8) & 255u), float((j >> 16) & 255u), float(j >> 24));\n  aWgt = unpackUnorm4x8(V.u[o + 9u]);\n  aShade = unpackUnorm4x8(V.u[o + 10u]);\n}\nvoid main() {{\n  skinVertex();\n  mat4 s = uBones[int(aJnt.x)] * aWgt.x + uBones[int(aJnt.y)] * aWgt.y + uBones[int(aJnt.z)] * aWgt.z + uBones[int(aJnt.w)] * aWgt.w;\n  vec4 wp = uModel * (s * vec4(aPos, 1.0));\n  vWp = wp.xyz;\n  vN = normalize(mat3(uModel) * (mat3(s) * aNrm));\n  vUv = aUv;\n  vCav = aShade.x;\n  ext_vertex();\n  gl_Position = vkClip(uViewProj * wp);\n}\n";
var SRC_skin_shadow_vert: string = "// a skinned mesh into the shadow map (the extension: RX_SKIN_SH_VS)\nvec3 aPos; vec3 aNrm; vec2 aUv; vec4 aJnt; vec4 aWgt; vec4 aShade;\n#pragma ext\n#ifndef MAX_BONES\n#define MAX_BONES 64\n#endif\n#define uBones Mats(DR.bones).m\nvoid main() {{\n  Uints V = Uints(DR.verts);\n  uint o = uint(gl_VertexIndex) * 11u;\n  aPos = uintBitsToFloat(uvec3(V.u[o], V.u[o + 1u], V.u[o + 2u]));\n  aNrm = uintBitsToFloat(uvec3(V.u[o + 3u], V.u[o + 4u], V.u[o + 5u]));\n  aUv = uintBitsToFloat(uvec2(V.u[o + 6u], V.u[o + 7u]));\n  uint j = V.u[o + 8u];\n  aJnt = vec4(float(j & 255u), float((j >> 8) & 255u), float((j >> 16) & 255u), float(j >> 24));\n  aWgt = unpackUnorm4x8(V.u[o + 9u]);\n  aShade = unpackUnorm4x8(V.u[o + 10u]);\n  ext_vertex();\n  mat4 s = uBones[int(aJnt.x)] * aWgt.x + uBones[int(aJnt.y)] * aWgt.y + uBones[int(aJnt.z)] * aWgt.z + uBones[int(aJnt.w)] * aWgt.w;\n  gl_Position = vkClip(uViewProj * (uModel * (s * vec4(aPos, 1.0))));\n}\n";
var SRC_sky_frag: string = "// the sky: marked far off -- its light is the lighting pass's (shaders/shade.frag skyL: the game's own gradient, the\n// sun's disc and glow)\nlayout(location = 0) in vec2 vNdc;\nvoid main() {{\n  gAlb = vec4(0.0);\n  gNrm = vec4(0.0);\n  gObj = vec4(0.0, 0.0, 0.0, 1000.0);\n  gEmi = vec4(0.0);\n}\n";
var SRC_sky_vert: string = "// one triangle over the whole screen (the sky, and every full-screen pass): vNdc its NDC, far off\nlayout(location = 0) out vec2 vNdc;\nconst vec2 P[3] = vec2[3](vec2(-1.0, -1.0), vec2(3.0, -1.0), vec2(-1.0, 3.0));\nvoid main() {{ vNdc = P[gl_VertexIndex]; gl_Position = vkClip(vec4(vNdc, 0.9999, 1.0)); }\n";
var SRC_static_vert: string = "// a static mesh, its vertices pulled from its buffer (DR.verts: 8 floats each -- position, normal, uv; the blocks' cube\n// the same). The extension: RX_STATIC_VS -- whatever it adds to the skinned meshes' varyings, set here too\nlayout(location = 0) out vec3 vWp; layout(location = 1) out vec3 vN; layout(location = 2) out vec2 vUv;\nlayout(location = 3) out float vCav;\nvec3 aPos; vec3 aNrm; vec2 aUv;\n#pragma ext\nvoid main() {{\n  Floats V = Floats(DR.verts);\n  uint o = uint(gl_VertexIndex) * 8u;\n  aPos = vec3(V.f[o], V.f[o + 1u], V.f[o + 2u]);\n  aNrm = vec3(V.f[o + 3u], V.f[o + 4u], V.f[o + 5u]);\n  aUv = vec2(V.f[o + 6u], V.f[o + 7u]);\n  vec4 wp = uModel * vec4(aPos, 1.0);\n  vWp = wp.xyz;\n  vN = normalize(mat3(uModel) * aNrm);\n  vUv = aUv;\n  vCav = 0.0;\n  ext_vertex();\n  gl_Position = vkClip(uViewProj * wp);\n}\n";
var SRC_static_shadow_vert: string = "// a static mesh into the shadow map (the extension: RX_STATIC_SH_VS)\nvec3 aPos;\n#pragma ext\nvoid main() {{\n  Floats V = Floats(DR.verts);\n  uint o = uint(gl_VertexIndex) * 8u;\n  aPos = vec3(V.f[o], V.f[o + 1u], V.f[o + 2u]);\n  ext_vertex();\n  gl_Position = vkClip(uViewProj * (uModel * vec4(aPos, 1.0)));\n}\n";
var SRC_textured_frag: string = "// a mesh as what it's made of: its colour, its roughness and metalness, its normal map (the surface texture's r g,\n// b a), the sculpt's creases occluding the light (the cavity), a hit's flash. Back faces (double-sided meshes) take the\n// flipped normal. The extension (RX_SURFACE_FS) may throw a fragment away first (ext_clip) and changes the surface\n// after (ext_surface): what it's made of, the light it gives off, a height over it (m) that bends its normal.\nlayout(location = 0) in vec3 vWp; layout(location = 1) in vec3 vN; layout(location = 2) in vec2 vUv;\nlayout(location = 3) in float vCav;\n#define uTex T2[DR.tex.x]      // the colour (sRGB)\n#define uSurf T2[DR.tex.y]     // r roughness, g metalness, b a the normal map's x y\n// a little height over the surface (m) bends its normal (Mikkelsen's surface gradient, by the screen's derivatives)\nvec3 bumpH(vec3 n, float h) {{\n  vec3 dpx = dFdx(vWp), dpy = dFdy(vWp);\n  vec3 r1 = cross(dpy, n), r2 = cross(n, dpx);\n  float det = dot(dpx, r1);\n  float dhx = dFdx(h), dhy = dFdy(h);\n  if (abs(det) < 1e-14) return n;\n  vec3 g = sign(det) * (dhx * r1 + dhy * r2);\n  float gl = length(g), lim = 0.8 * abs(det);\n  if (gl > lim) g *= lim / gl;\n  return normalize(abs(det) * n - g);\n}\n\n#pragma ext\n\nvoid main() {{\n  ext_clip();\n  vec3 ng = normalize(gl_FrontFacing ? vN : -vN);\n  vec4 sf = texture(uSurf, vUv);\n  vec3 tn = vec3(sf.b * 2.0 - 1.0, sf.a * 2.0 - 1.0, 0.0);\n  tn.z = sqrt(max(1.0 - dot(tn.xy, tn.xy), 0.0));\n  vec3 n = normalize(cotangentFrame(ng, vWp, vUv) * tn + ng * 0.02);\n  if (dot(n, ng) < 0.05) n = normalize(n + ng * (0.05 - dot(n, ng)));\n  vec3 tc = texture(uTex, vUv).rgb;\n  vec3 alb = lin(tc) * uTint;\n  float rough = sf.r;\n  float metal = sf.g;\n  float occ = 1.0 - 0.75 * vCav;\n  vec3 emit = vec3(1.0, 0.45, 0.15) * uGlow * 3.0;\n  float H = 0.0;\n  ext_surface(tc, alb, rough, metal, occ, emit, H);\n  n = bumpH(n, H);\n  writeG(alb, occ, n, rough, metal, emit, vWp);\n}\n";
var SRC_vk_glsl: string = "#version 460\n// THE PRELUDE: ahead of every engine shader (and so of every extension a game splices into one). What a shader sees:\n//   textures      T2[i]: every texture and render target the engine has, by its index (a VkImg's tex); TS[i] the\n//                 depth compared on lookup (the sun's shadow map); I16[i] / I8[i] the RGBA16F / RGBA8 targets a\n//                 compute pass writes (a VkImg's stor)\n//   the frame     FR: what the whole frame shares -- the camera, the sun's cascades, the light, the screen\n//   the draw      DR: this draw's (or pass's) own -- its model, its view-projection, its textures, its parameters,\n//                 its vertices' and bones' addresses\n//   the game's    EX: the 256 bytes its hook filled for this draw (vec4 v[16]; or its own buffer_reference type over\n//                 PC.ext)\n// The uniforms the GL engine had keep their names (uSunDir, uModel ...) as macros over these.\n// Varyings take explicit locations: the engine's 0..3; a game's extension 8 and up.\n#extension GL_EXT_buffer_reference : require\n#extension GL_EXT_buffer_reference_uvec2 : require\n#extension GL_EXT_nonuniform_qualifier : require\n\nlayout(set = 0, binding = 0) uniform sampler2D T2[];\nlayout(set = 0, binding = 1) uniform sampler2DShadow TS[];\nlayout(set = 0, binding = 2, rgba16f) uniform image2D I16[];\nlayout(set = 0, binding = 3, rgba8) uniform image2D I8[];\n\nlayout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer FrameB {{\n  mat4 vp;            // the camera's view-projection\n  mat4 inv_vp;\n  mat4 prev_vp;       // last frame's\n  mat4 light_vp0;     // the sun's two cascades\n  mat4 light_vp1;\n  vec4 sun_dir;       // xyz toward the sun\n  vec4 sun_col;\n  vec4 sky_col;\n  vec4 gnd_col;\n  vec4 fog;           // rgb its colour, a its density\n  vec4 cam;           // xyz the camera, w the time (s)\n  vec4 screen;        // w, h, the projection's y scale, the exposure\n  vec4 misc;          // xy each cascade's texel (m), z how much of the glow\n};\nlayout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer DrawB {{\n  mat4 model;\n  mat4 vp;            // what it's drawn through (the camera, or a cascade of the sun)\n  vec4 tint;          // rgb a tint, a a glow\n  vec4 obj;           // x the object id, y its class\n  ivec4 tex;          // textures (T2[] / TS[]; w a compute pass's target: I16[] / I8[])\n  ivec4 tex2;\n  vec4 p0;            // a pass's parameters\n  vec4 p1;\n  uvec2 bones;        // the skinning palette (mat4s)\n  uvec2 verts;        // the vertices\n};\nlayout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer Floats {{ float f[]; };\nlayout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer Uints {{ uint u[]; };\nlayout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer Mats {{ mat4 m[]; };\nlayout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer ExtB {{ vec4 v[16]; };\nlayout(push_constant) uniform Push {{ uvec2 frame; uvec2 draw; uvec2 ext; uvec2 pad; } PC;\n#define FR FrameB(PC.frame)\n#define DR DrawB(PC.draw)\n#define EX ExtB(PC.ext)\n\n// the frame's (the GL engine's uniforms, by their names)\n#define uVP FR.vp\n#define uInvVP FR.inv_vp\n#define uPrevVP FR.prev_vp\n#define uLightVP0 FR.light_vp0\n#define uLightVP1 FR.light_vp1\n#define uSunDir FR.sun_dir.xyz\n#define uSunCol FR.sun_col.xyz\n#define uSkyCol FR.sky_col.xyz\n#define uGndCol FR.gnd_col.xyz\n#define uFogCol FR.fog.xyz\n#define uFogDen FR.fog.w\n#define uCamPos FR.cam.xyz\n#define uTime FR.cam.w\n#define uScreen FR.screen.xy\n#define uP11 FR.screen.z\n#define uExposure FR.screen.w\n#define uCascTexel FR.misc.xy\n#define uBloom FR.misc.z\n// the draw's\n#define uModel DR.model\n#define uViewProj DR.vp\n#define uTint DR.tint.rgb\n#define uGlow DR.tint.a\n#define uObj DR.obj.x\n#define uClass DR.obj.y\n\n// GL's clip depth (-w..w) as Vulkan's (0..w): the depth stored is what GL stored, so every pass that reads it back\n// (z * 2 - 1 into NDC) reads it as it did\nvec4 vkClip(vec4 p) {{ return vec4(p.xy, (p.z + p.w) * 0.5, p.w); }\n";
