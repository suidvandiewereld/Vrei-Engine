// the occlusion smoothed one way (uDir), across the same surface only: each tap weighted by a Gaussian and by how near
// its distance is to this pixel's (an edge between near and far isn't blurred over). Out: I16[DR.tex.w]
layout(local_size_x = 8, local_size_y = 8) in;
#define uSrc T2[DR.tex.x]      // r the occlusion, g the distance
#define uDir DR.p0.xy
void main() {
  ivec2 ip = ivec2(gl_GlobalInvocationID.xy);
  if (ip.x >= int(uScreen.x) || ip.y >= int(uScreen.y)) return;
  vec4 c0 = texelFetch(uSrc, ip, 0);
  float D = c0.g;
  float s = c0.r, w = 1.0;
  for (int k = -4; k <= 4; k++) {
    if (k == 0) continue;
    ivec2 q = clamp(ip + ivec2(uDir * float(k) * 1.5), ivec2(0), ivec2(uScreen) - 1);
    vec4 cq = texelFetch(uSrc, q, 0);
    float g = exp(-float(k * k) / 9.0);
    float wd = max(0.0, 1.0 - abs(cq.g - D) / (0.03 * D + 0.05));
    s += cq.r * g * wd;
    w += g * wd;
  }
  imageStore(I16[DR.tex.w], ip, vec4(s / w, D, 0.0, 1.0));
}
