// FXAA (Lottes), a compute pass: the frame's edges smoothed -- the luma's gradient across each pixel finds the edge's
// direction, two taps along it either side blend it, kept only if they don't overshoot the neighbourhood's range.
// Out: I8[DR.tex.w]
layout(local_size_x = 8, local_size_y = 8) in;
#define uSrc T2[DR.tex.x]      // the display colour, a: its luma
vec4 tx(vec2 uv) { return textureLod(uSrc, uv, 0.0); }
void main() {
  ivec2 ip = ivec2(gl_GlobalInvocationID.xy);
  if (ip.x >= int(uScreen.x) || ip.y >= int(uScreen.y)) return;
  vec2 rcp = 1.0 / uScreen;
  vec2 uv = (vec2(ip) + 0.5) * rcp;
  float lNW = tx(uv + vec2(-1.0, -1.0) * rcp).a;
  float lNE = tx(uv + vec2(1.0, -1.0) * rcp).a;
  float lSW = tx(uv + vec2(-1.0, 1.0) * rcp).a;
  float lSE = tx(uv + vec2(1.0, 1.0) * rcp).a;
  vec4 M = tx(uv);
  float lM = M.a;
  float lMin = min(lM, min(min(lNW, lNE), min(lSW, lSE)));
  float lMax = max(lM, max(max(lNW, lNE), max(lSW, lSE)));
  if (lMax - lMin < max(0.0312, lMax * 0.125)) { imageStore(I8[DR.tex.w], ip, vec4(M.rgb, 1.0)); return; }
  vec2 dir = vec2(-((lNW + lNE) - (lSW + lSE)), (lNW + lSW) - (lNE + lSE));
  float red = max((lNW + lNE + lSW + lSE) * 0.25 * 0.125, 1.0 / 128.0);
  float rmin = 1.0 / (min(abs(dir.x), abs(dir.y)) + red);
  dir = clamp(dir * rmin, vec2(-8.0), vec2(8.0)) * rcp;
  vec3 A = 0.5 * (tx(uv + dir * (1.0 / 3.0 - 0.5)).rgb + tx(uv + dir * (2.0 / 3.0 - 0.5)).rgb);
  vec3 B = A * 0.5 + 0.25 * (tx(uv - dir * 0.5).rgb + tx(uv + dir * 0.5).rgb);
  float lB = dot(B, vec3(0.299, 0.587, 0.114));
  imageStore(I8[DR.tex.w], ip, vec4((lB < lMin || lB > lMax) ? A : B, 1.0));
}
