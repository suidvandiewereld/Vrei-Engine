// GLSL as Mettle strings -- generated by tools/embed_shaders.mettle from tests; don't edit by hand
var SRC_hello_vk_comp: string = "#version 460\n// a gradient written straight into the target (its I8[] index in the push constants' second slot)\n#extension GL_EXT_nonuniform_qualifier : require\nlayout(local_size_x = 8, local_size_y = 8) in;\nlayout(set = 0, binding = 3, rgba8) uniform image2D I8[];\nlayout(push_constant) uniform Push {{ uvec2 frame; uvec2 draw; uvec2 ext; uvec2 pad; } PC;\nvoid main() {{\n  ivec2 p = ivec2(gl_GlobalInvocationID.xy);\n  ivec2 s = imageSize(I8[PC.draw.x]);\n  if (p.x >= s.x || p.y >= s.y) return;\n  imageStore(I8[PC.draw.x], p, vec4(vec2(p) / vec2(s) * 0.6, 0.25, 1.0));\n}\n";
var SRC_hello_vk_frag: string = "#version 460\nlayout(location = 0) in vec3 vCol;\nlayout(location = 0) out vec4 oCol;\nvoid main() {{ oCol = vec4(vCol, 1.0); }\n";
var SRC_hello_vk_vert: string = "#version 460\nlayout(location = 0) out vec3 vCol;\nconst vec2 P[3] = vec2[3](vec2(-0.6, -0.5), vec2(0.6, -0.5), vec2(0.0, 0.6));\nconst vec3 C[3] = vec3[3](vec3(1.0, 0.25, 0.2), vec3(0.2, 1.0, 0.3), vec3(0.25, 0.35, 1.0));\nvoid main() {{ vCol = C[gl_VertexIndex]; gl_Position = vec4(P[gl_VertexIndex], 0.5, 1.0); }\n";
