// embed_shaders <dir> <out.mettle>: every GLSL file under dir (.glsl .vert .frag .comp, its subfolders too) as a Mettle
// string in out, one var a file -- SRC_<its path under dir> (ao.comp is SRC_ao_comp, ext/light.glsl
// SRC_ext_light_glsl). It stands in for import_str, which embeds nothing in the Mettle v0.17.0 builds (the bytes are
// read but the string comes out empty). Run by build.bat; re-run it after editing a shader.
import "std/io";
import "std/mem";

extern fn E_FindFirstFileA(pattern: cstring, data: uint8*) -> int64 = "FindFirstFileA";
extern fn E_FindNextFileA(h: int64, data: uint8*) -> int32 = "FindNextFileA";
extern fn E_FindClose(h: int64) -> int32 = "FindClose";

var OUT: uint8* = 0;
var OUT_N: int64 = 0;
var OUT_CAP: int64 = 0;

fn put(c: uint8) {
  if (OUT_N + 1 > OUT_CAP) {
    var cap: int64 = OUT_CAP * 2 + 65536;
    var nb: uint8* = (uint8*)malloc(cap);
    if (OUT_N > 0) { memcpy((rawptr)nb, (rawptr)OUT, OUT_N); }
    OUT = nb;
    OUT_CAP = cap;
  }
  OUT[OUT_N] = c;
  OUT_N = OUT_N + 1;
}
fn put_s(s: cstring) {
  var i: int64 = 0;
  while (s[i] != (uint8)0) { put(s[i]); i = i + 1; }
}

fn slen(s: cstring) -> int64 {
  var n: int64 = 0;
  while (s[n] != (uint8)0) { n = n + 1; }
  return n;
}
// a + b + c, a new string
fn cat3(a: cstring, b: cstring, c: cstring) -> cstring {
  var na: int64 = slen(a);
  var nb: int64 = slen(b);
  var nc: int64 = slen(c);
  var o: uint8* = (uint8*)malloc(na + nb + nc + 1);
  memcpy((rawptr)o, (rawptr)a, na);
  memcpy((rawptr)(o + na), (rawptr)b, nb);
  memcpy((rawptr)(o + na + nb), (rawptr)c, nc);
  o[na + nb + nc] = (uint8)0;
  return (cstring)o;
}
fn ends(s: cstring, suf: cstring) -> int32 {
  var n: int64 = slen(s);
  var m: int64 = slen(suf);
  if (m > n) { return 0; }
  var i: int64 = 0;
  while (i < m) {
    if (s[n - m + i] != suf[i]) { return 0; }
    i = i + 1;
  }
  return 1;
}

fn read_all(path: cstring, size: int64*) -> uint8* {
  var fp: cstring = fopen(path, "rb".chars);
  if (fp == 0) { return (uint8*)0; }
  var cap: int64 = 1 << 20;
  var buf: uint8* = (uint8*)malloc(cap + 1);
  var n: int64 = fread((cstring)buf, 1, cap, fp);
  fclose(fp);
  if (n >= cap) { print("too big: "); println_cstr(path); return (uint8*)0; }
  buf[n] = (uint8)0;
  *size = n;
  return buf;
}

// one file: var SRC_<rel>: string = "<its text, escaped>";
fn embed(path: cstring, rel: cstring) -> int32 {
  var n: int64 = 0;
  var t: uint8* = read_all(path, &n);
  if (t == 0) { print("can't read "); println_cstr(path); return 0; }
  put_s("var SRC_".chars);
  var i: int64 = 0;
  while (rel[i] != (uint8)0) {
    var c: uint8 = rel[i];
    var ok: int32 = 0;
    if ((c >= (uint8)48 && c <= (uint8)57) || (c >= (uint8)65 && c <= (uint8)90) || (c >= (uint8)97 && c <= (uint8)122)) { ok = 1; }
    if (ok != 0) { put(c); } else { put((uint8)95); }
    i = i + 1;
  }
  put_s(": string = \"".chars);
  i = 0;
  while (i < n) {
    var c2: uint8 = t[i];
    // (a Mettle string: \ and " escaped, { doubled -- a lone { opens an interpolation -- each line a \n, no \r)
    if (c2 == (uint8)92) { put((uint8)92); put((uint8)92); }
    else if (c2 == (uint8)34) { put((uint8)92); put((uint8)34); }
    else if (c2 == (uint8)123) { put((uint8)123); put((uint8)123); }
    else if (c2 == (uint8)10) { put((uint8)92); put((uint8)110); }
    else if (c2 == (uint8)9) { put((uint8)92); put((uint8)116); }
    else if (c2 != (uint8)13) { put(c2); }
    i = i + 1;
  }
  put_s("\";\n".chars);
  return 1;
}

// every shader under dir (rel: its path so far, "" at the top)
fn walk(dir: cstring, rel: cstring) -> int32 {
  var fd: uint8* = (uint8*)malloc(592);                          // (WIN32_FIND_DATAA, with room)
  var h: int64 = E_FindFirstFileA(cat3(dir, "\\*".chars, "".chars), fd);
  if (h == -1) { print("no such folder: "); println_cstr(dir); return 0; }
  var ok: int32 = 1;
  var more: int32 = 1;
  while (more != 0) {
    var attr: uint32 = *(uint32*)fd;
    var name: cstring = (cstring)(fd + 44);                     // (cFileName)
    var dot: int32 = 0;
    if (name[0] == (uint8)46) { dot = 1; }
    if (dot == 0) {
      var full: cstring = cat3(dir, "\\".chars, name);
      var sub: cstring = name;
      if (rel[0] != (uint8)0) { sub = cat3(rel, "/".chars, name); }
      if ((attr & (uint32)16) != (uint32)0) {
        if (walk(full, sub) == 0) { ok = 0; }
      } else if (ends(name, ".glsl".chars) != 0 || ends(name, ".vert".chars) != 0 || ends(name, ".frag".chars) != 0
                 || ends(name, ".comp".chars) != 0) {
        if (embed(full, sub) == 0) { ok = 0; }
      }
    }
    more = E_FindNextFileA(h, fd);
  }
  E_FindClose(h);
  return ok;
}

fn main(argc: int32, argv: cstring*) -> int32 {
  if (argc < 3) { println("usage: embed_shaders <dir> <out.mettle>"); return 1; }
  put_s("// GLSL as Mettle strings -- generated by tools/embed_shaders.mettle from ".chars);
  put_s(argv[1]);
  put_s("; don't edit by hand\n".chars);
  if (walk(argv[1], "".chars) == 0) { return 1; }
  var fp: cstring = fopen(argv[2], "wb".chars);
  if (fp == 0) { print("can't write "); println_cstr(argv[2]); return 1; }
  fwrite((cstring)OUT, 1, OUT_N, fp);
  fclose(fp);
  return 0;
}
